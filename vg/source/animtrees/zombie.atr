}

aim_graft_node : additive unnormalized graft
{
}

ragdoll : public clientauth overlay ragdoll (ragdoll_handle=[entity_ragdoll_handle])
{
}

shoot_additives_rpg : toggle( index=[shootstyle], restart="false" ) additive
{
	shoot_idle : randomloop( blendtime=".2", restart="false", seed=[animtime] ) unnormalized
	{
		sdr_com_exposed_stand_rpg_idle01@2
	}

	shoot_single : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_rpg_fire@2
	}

	shoot_semi : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) 
	{
		sdr_com_exposed_stand_rpg_fire@3
		sdr_com_exposed_stand_rpg_fire@4
		sdr_com_exposed_stand_rpg_fire@5
		sdr_com_exposed_stand_rpg_fire@6
	}

	shoot_full : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) 
	{
		sdr_com_exposed_stand_rpg_fire@7
		sdr_com_exposed_stand_rpg_fire@8
		sdr_com_exposed_stand_rpg_fire@9
		sdr_com_exposed_stand_rpg_fire@10
		sdr_com_exposed_stand_rpg_fire@11
	}
}

shoot_additives_rifle : toggle( index=[shootstyle], restart="false" ) additive
{
	shoot_idle : randomloop( blendtime=".2", restart="false", seed=[animtime] ) unnormalized
	{
		sdr_com_exposed_twitch01@2
		sdr_com_exposed_twitch02@2
		sdr_com_exposed_twitch03@2
		sdr_com_exposed_twitch04@2
	}

	shoot_single : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_semi_01@2
	}

	shoot_semi : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for semi-auto to start at 2 shots 
		sdr_com_exposed_semi_02@3
		sdr_com_exposed_semi_03@3
		sdr_com_exposed_semi_04@3
		sdr_com_exposed_semi_05@3
	}

	shoot_full : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for full-auto to start at 2 shots 
		sdr_com_exposed_burst_02@3
		sdr_com_exposed_burst_03@3
		sdr_com_exposed_burst_04@3
		sdr_com_exposed_burst_05@3
		sdr_com_exposed_burst_06@3
		s4_sdr_com_exposed_burst_20@3
	}
	
	shoot_rack : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_shotgun_fire01
		sdr_com_exposed_stand_shotgun_fire02
		sdr_com_exposed_stand_shotgun_fire03
	}
}

shoot_additives_rifle_rebel : toggle( index=[shootstyle] ) additive
{
	shoot_idle : randomloop( blendtime=".2", restart="false", seed=[animtime] ) unnormalized
	{
		reb_com_exposed_twitch01
		reb_com_exposed_twitch02
		reb_com_exposed_twitch03
		reb_com_exposed_twitch04
	}
	
	shoot_single : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_semi_01@3
	}
	
	shoot_semi : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for semi-auto to start at 2 shots 
		sdr_com_exposed_semi_02@2
		sdr_com_exposed_semi_03@2
		sdr_com_exposed_semi_04@2
		sdr_com_exposed_semi_05@2
	}
	
	shoot_full : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for full-auto to start at 2 shots 
		sdr_com_exposed_burst_02@2
		sdr_com_exposed_burst_03@2
		sdr_com_exposed_burst_04@2
		sdr_com_exposed_burst_05@2
		sdr_com_exposed_burst_06@2
		s4_sdr_com_exposed_burst_20@2
	}

	shoot_rack : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_shotgun_fire01@2
		sdr_com_exposed_stand_shotgun_fire02@2
		sdr_com_exposed_stand_shotgun_fire03@2
	}
}

shoot_additives_pistol : toggle( index=[shootstyle], restart="false" ) additive
{
	shoot_idle : randomloop( blendtime=".2", restart="false", seed=[animtime] ) unnormalized
	{
		exposed_idle_alert_v1@2
		exposed_idle_alert_v2@2
		exposed_idle_alert_v3@2
	}

	shoot_single : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_pstl_fire01@2
	}

	shoot_semi : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for semi-auto to start at 2 shots 
		sdr_com_exposed_stand_pstl_burst_02@2
		sdr_com_exposed_stand_pstl_burst_03@2
		sdr_com_exposed_stand_pstl_burst_04@2
		sdr_com_exposed_stand_pstl_burst_05@2
	}

	shoot_full : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_pstl_burst_02@3
		sdr_com_exposed_stand_pstl_burst_03@3
		sdr_com_exposed_stand_pstl_burst_04@3
		sdr_com_exposed_stand_pstl_burst_05@3
		sdr_com_exposed_stand_pstl_burst_05@4
	}
	
	shoot_rack : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_pstl_fire01@3
		sdr_com_exposed_stand_pstl_fire01@4
		sdr_com_exposed_stand_pstl_fire01@5
	}
}

