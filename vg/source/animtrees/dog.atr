	//Additive Dog Slope Blendspace
	//
	//Includes Both pitch and roll up to 45 degrees in any direction (30 in diagonal)
	slope : additive
	{	
			slope_pitch_roll_blendspace: blendspace2d( rangex="-45,45", rangey="-45,45", blend_time="250",//(time in Milliseconds)
			coords="{45,0},{33,0},{30,-30},{30,30},{0,-33},{0,-45},{-10,0},{10,0},{0,10},{0,-10},{0,0},{0,33},{0,45},{-33,0},{-30,-30},{-30,30},{-45,0}",
