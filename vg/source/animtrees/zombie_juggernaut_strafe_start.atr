		ai_s4_zm_zombie_juggernaut_strafe_walk_start_2@1
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_3
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_6
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_9
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_8
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_7
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_4
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_1
		ai_s4_zm_zombie_juggernaut_strafe_walk_start_2
	}
