    return trace;
}

convert_capsule_data( _id_CC43F8A28DC3BC22, _id_B26C88A9B9F4EF65, radius, height, angles )
{
    if ( !isdefined( angles ) )
        angles = ( 0, 0, 0 );

    half_height = height * 0.5;
    forward = anglestoforward( angles );
    up = anglestoup( angles );
    capsule_data = [];
    capsule_data["trace_start"] = _id_CC43F8A28DC3BC22 + up * half_height;

    if ( isdefined( _id_B26C88A9B9F4EF65 ) )
        capsule_data["trace_end"] = _id_B26C88A9B9F4EF65 + up * half_height;

    capsule_data["radius"] = radius;
    capsule_data["angles"] = angles;
    capsule_data["half_height"] = half_height;
    return capsule_data;
}

