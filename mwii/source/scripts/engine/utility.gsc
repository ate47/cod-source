getaimyawtopoint( point )
{
    yaw = getyawtospot( point );
    dist = distance( self.origin, point );

    if ( dist > 3 )
    {
        anglefudge = asin( -3 / dist );
        yaw = yaw - anglefudge;
    }

    yaw = angleclamp180( yaw );
    return yaw;
}

getyawtospot( spot )
