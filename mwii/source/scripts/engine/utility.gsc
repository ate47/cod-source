alphabetize( array )
{
    if ( array.size <= 1 )
        return array;

    count = 0;

    for ( asize = array.size - 1; asize >= 1; asize-- )
    {
        largest = array[asize];
        largestindex = asize;

        for ( i = 0; i < asize; i++ )
        {
            string1 = array[i];

            if ( stricmp( string1, largest ) > 0 )
            {
                largest = string1;
                largestindex = i;
            }
        }

        if ( largestindex != asize )
        {
            array[largestindex] = array[asize];
            array[asize] = largest;
        }
    }

    return array;
}

