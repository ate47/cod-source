    }

    foreach ( nodetypeit in nodetypelist )
    {
        switch ( nodetypeit )
        {
            case "Cover Stand":
            case "Cover Crouch":
                if ( abs( yaw_diff ) < 30 )
                    return nodetypeit;

                break;
            case "Cover Left Crouch":
            case "Cover Left":
                if ( yaw_diff > 30 )
                    return "Cover Left";

                break;
            case "Cover Right Crouch":
            case "Cover Right":
                if ( yaw_diff < -30 )
                    return "Cover Right";

                break;
            default:
        }
    }

    nodetype = nodetypelist[0];

    switch ( nodetype )
    {
        case "Cover Left Crouch":
            return "Cover Left";
        case "Cover Right Crouch":
            return "Cover Right";
    }

    return nodetype;
}

