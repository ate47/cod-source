random_weighted( array, weights )
{
    totalweight = 0;

    foreach ( value in weights )
        totalweight = totalweight + value;

    if ( totalweight == 0 )
        return undefined;

    weight = randomint( totalweight );
    chosenvalue = undefined;

    foreach ( i, value in array )
    {
        if ( weight < weights[i] )
        {
            chosenvalue = value;
            break;
        }
        else
            weight = weight - weights[i];
    }

    return chosenvalue;
}

