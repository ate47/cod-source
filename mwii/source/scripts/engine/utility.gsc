choose_from_weighted_array( values, weights )
{
    randomval = randomint( weights[weights.size - 1] + 1 );

    for ( i = 0; i < weights.size; i++ )
    {
        if ( randomval <= weights[i] )
            return values[i];
    }
}

waittill_string( msg, ent )
{
    if ( msg != "death" )
        self endon( "death" );

    ent endon( "die" );
    self waittill( msg );
    ent notify( "returned", msg );
}

