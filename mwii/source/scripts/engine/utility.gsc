    deck.autoshuffle = !isdefined( autoshuffle ) || autoshuffle;
    deck.prevent_redraw = !isdefined( prevent_redraw ) || prevent_redraw;

    foreach ( item in item_array )
        deck.items[deck.items.size] = item;

