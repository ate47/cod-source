draw_ent_bone_forever( bone_name, origin_color )
{
    self endon( "stop_drawing_axis" );
    self endon( "death" );

    for (;;)
    {
        bone_origin = self gettagorigin( bone_name );
        bone_angles = self gettagangles( bone_name );
        draw_angles( bone_angles, bone_origin, origin_color );
        waitframe();
    }
}

draw_ent_axis_forever( origin_color, scale )
{
    self endon( "stop_drawing_axis" );
    self endon( "death" );

    for (;;)
    {
        draw_ent_axis( origin_color, undefined, scale );
        waitframe();
    }
}

draw_tag_axis_forever( tag, origin_color, scale )
{
    self endon( "stop_drawing_axis" );
    self endon( "death" );

    for (;;)
    {
        draw_tag_axis( tag, origin_color, undefined, scale );
        waitframe();
    }
}

draw_ent_axis( origin_color, duration, scale )
{
    waittillframeend;

    if ( isdefined( self.angles ) )
        angles = self.angles;
    else
        angles = ( 0, 0, 0 );

    draw_angles( angles, self.origin, origin_color, duration, scale );
}

draw_tag_axis( tag, origin_color, duration, scale )
{
    waittillframeend;
    angles = self gettagangles( tag );
    origin = self gettagorigin( tag );
    draw_angles( angles, origin, origin_color, duration, scale );
}

draw_angles( angles, origin, origin_color, duration, scale )
{
    waittillframeend;
    forward = anglestoforward( angles );
    right = anglestoright( angles );
    up = anglestoup( angles );

    if ( !isdefined( origin_color ) )
        origin_color = ( 1, 0, 1 );

    if ( !isdefined( duration ) )
        duration = 1;

    if ( !isdefined( scale ) )
        scale = 10;
}

