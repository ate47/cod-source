randomvector( num )
{
    return ( randomfloat( num ) - num * 0.5, randomfloat( num ) - num * 0.5, randomfloat( num ) - num * 0.5 );
}

randomvectorrange( num_min, num_max )
{
    x = randomfloatrange( num_min, num_max );

    if ( randomint( 2 ) == 0 )
        x = x * -1;

    y = randomfloatrange( num_min, num_max );

    if ( randomint( 2 ) == 0 )
        y = y * -1;

    z = randomfloatrange( num_min, num_max );

    if ( randomint( 2 ) == 0 )
        z = z * -1;

    return ( x, y, z );
}

sign( x )
{
    if ( x >= 0 )
        return 1;

    return -1;
}

randomonunitsphere()
{
    theta = randomfloat( 180 );
    phi = randomfloat( 360 );
    x = cos( phi ) * cos( theta );
    y = cos( phi ) * sin( theta );
    z = sin( phi );
    return ( x, y, z );
}

