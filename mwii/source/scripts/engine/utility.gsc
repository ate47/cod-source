waittill_any_in_array( string_array )
{
    for ( i = 0; i < string_array.size - 1; i++ )
        self endon( string_array[i] );

    self waittill( string_array[string_array.size - 1] );
}

waittill_any_in_array_return( string_array )
{
    ent = spawnstruct();
    hasdeath = 0;

    foreach ( string in string_array )
    {
        childthread waittill_string( string, ent );

        if ( string == "death" )
            hasdeath = 1;
    }

    if ( !hasdeath )
        self endon( "death" );

    ent waittill( "returned", msg );
    ent notify( "die" );
    return msg;
}

