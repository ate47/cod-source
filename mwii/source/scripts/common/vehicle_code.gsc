    scripts\common\vehicle::_id_89CEC1224AE724D5();
    healthinc = int( ( self.health - self.healthbuffer ) / 30.0 / 0.25 ) + 1;

    while ( gettime() - self.burndownstart < 30000 )
    {
        countdown = 30000 - ( gettime() - self.burndownstart );
        scripts\common\vehicle::vehicle_damage( healthinc, undefined, "MOD_EXECUTION" );
        wait 1;
    }
}

