                        {
                            rideranimpos = scripts\common\vehicle_aianim::anim_pos( self, rider.vehicle_position );

                            if ( rideranimpos.fastroperig == animpos.fastroperig )
                            {
                                usingrope = 1;
                                break;
                            }
