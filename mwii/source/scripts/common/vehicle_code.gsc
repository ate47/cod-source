vehicle_playengineeffect()
{
    enginefx = level.vehicle.templates.engine_fx[self.classname];

    if ( !isdefined( enginefx ) )
        return;

    effectdelay = 0.25;
    prev_effect = undefined;
    _id_35C675F4F473AB8C = undefined;

    for (;;)
    {
        if ( !vehicle_isalive( self ) )
            return;

        _id_D1D99B2513672267 = enginefx.effect;
        _id_35C675F4F473AB8C = enginefx.effect_tag;
        effort_ratio = self vehicle_getspeed() / self vehicle_gettopspeedforward();

        if ( isdefined( self.enginefx_effort_scale ) )
            effort_ratio = effort_ratio * self.enginefx_effort_scale;

        if ( isdefined( enginefx.max_effort_effect ) && effort_ratio >= enginefx.max_effort_ratio )
            _id_D1D99B2513672267 = enginefx.max_effort_effect;
        else if ( isdefined( enginefx.med_effort_effect ) && effort_ratio >= enginefx.med_effort_ratio )
            _id_D1D99B2513672267 = enginefx.med_effort_effect;
        else if ( isdefined( enginefx.min_effort_effect ) && effort_ratio >= enginefx.min_effort_ratio )
            _id_D1D99B2513672267 = enginefx.min_effort_effect;

        if ( !isdefined( prev_effect ) || prev_effect != _id_D1D99B2513672267 )
        {
            if ( isdefined( prev_effect ) )
            {
                stopfxontag( prev_effect, self, _id_35C675F4F473AB8C );
                waitframe();

                if ( !vehicle_isalive( self ) )
                    return;
            }

            playfxontag( _id_D1D99B2513672267, self, _id_35C675F4F473AB8C );
            prev_effect = _id_D1D99B2513672267;
        }

        wait( effectdelay );
    }
}

vehicle_pathdetach()
