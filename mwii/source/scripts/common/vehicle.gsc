vehicle_sethealth( amount, resetstarting )
{
    if ( !isdefined( self.healthbuffer ) )
        self.healthbuffer = 0;

    amount = int( amount + self.healthbuffer );
    self.health = amount;
    self.healthactual = amount;

    if ( istrue( resetstarting ) )
        self.healthstarting = amount - self.healthbuffer;
}

vehicle_addhealth( amount, resetstarting )
{
    amount = int( amount );

    if ( !isdefined( self.healthbuffer ) )
        self.healthbuffer = 0;

    self.health = self.health + amount;
    self.healthactual = self.health;

    if ( istrue( resetstarting ) )
        self.healthstarting = self.health - self.healthbuffer;
}

_id_C8A94ACEF0BEB362( amount, resetstarting )
{
    amount = int( amount );

    if ( !isdefined( self.healthbuffer ) )
        self.healthbuffer = 0;

    if ( amount >= self.health )
    {
        vehicle_kill( level );
        return;
    }

    self.health = self.health - amount;
    self.healthactual = self.health;

    if ( istrue( resetstarting ) )
        self.healthstarting = self.health - self.healthbuffer;
}

