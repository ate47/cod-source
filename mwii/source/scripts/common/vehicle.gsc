init_vehicles()
{
    if ( getdvarint( "dvar_742CAA13B3C2E685", 0 ) )
        return;

    if ( isdefined( level.disablevehiclescripts ) && level.disablevehiclescripts )
        return;

    if ( !scripts\engine\utility::add_init_script( "vehicles", ::init_vehicles ) )
        return;

    thread init_vehicles_thread();
    cleanup_vt();
}

