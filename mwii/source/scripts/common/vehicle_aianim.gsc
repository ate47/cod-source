        if ( isdefined( animpos.getoutloopsnd ) )
            guy thread scripts\engine\utility::stop_loop_sound_on_entity( animpos.getoutloopsnd );

        if ( isdefined( guy.playerpiggyback ) && isdefined( animpos.player_getout_sound_end ) )
