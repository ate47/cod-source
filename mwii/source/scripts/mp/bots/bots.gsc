                clientcounts = cat_array_add( clientcounts, "bots_" + player.team );
                continue;
            }

            clientcounts = cat_array_add( clientcounts, "humans" );
            clientcounts = cat_array_add( clientcounts, "humans_" + player.team );
        }
    }

    return clientcounts;
}

cat_array_add( arraycounts, category )
