        _id_199A5EBBB9CA9FA2 = getentarray( "revive_trigger", "targetname" );
        _id_2B6486BBC80874AD = level.revivetriggers;
        revive_triggers = scripts\engine\utility::array_combine( _id_199A5EBBB9CA9FA2, _id_2B6486BBC80874AD );

