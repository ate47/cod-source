bot_item_matches_purpose( purpose, weaponitem )
{
    switch ( purpose )
    {
        case "trap_directional":
            switch ( weaponitem.basename )
            {
                case "claymore_mp":
                    return 1;
            }

            break;
        case "trap":
            switch ( weaponitem.basename )
            {
                case "motion_sensor_mp":
                case "proximity_explosive_mp":
                case "trophy_mp":
                case "at_mine_mp":
                    return 1;
            }

            break;
        case "trap_follower":
            switch ( weaponitem.basename )
            {
                case "tracking_drone_mp":
                    return 1;
            }

            break;
        case "c4":
            switch ( weaponitem.basename )
            {
                case "c4_mp":
                    return 1;
            }

            break;
        case "tacticalinsertion":
            switch ( weaponitem.basename )
            {
                case "flare_mp":
                    return 1;
            }

            break;
    }

    return 0;
}

