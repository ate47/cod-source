        bot_add_to_bot_use_targets( _id_AE802F9C07F6FDAC );
    else if ( _id_AE802F9C07F6FDAC.bot_interaction_type == "damage" )
        bot_add_to_bot_damage_targets( _id_AE802F9C07F6FDAC );
    else
    {

    }
