rpgplayerrepulsor_getnummisses()
{
    skill = scripts\common\utility::getdifficulty();

    switch ( skill )
    {
        case "gimp":
        case "easy":
            return 2;
        case "difficult":
        case "hard":
        case "medium":
            return 1;
        case "fu":
            return 0;
    }

    return 2;
}

