_id_AC31838F9EDDE417( array, states, random )
{
    if ( !isdefined( level.battlechatter.customstealth ) )
        level.battlechatter.customstealth = [];

    if ( !isarray( states ) )
        states = [ states ];

    foreach ( state in states )
    {
