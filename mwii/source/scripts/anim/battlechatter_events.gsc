    if ( scripts\engine\utility::is_dead_or_dying( self ) || !isdefined( self.team ) || self.team == "dead" )
        return;

    if ( scripts\common\utility::issp() && _id_35DE402EFC5ACFB3::getaiinrange( self.origin, level.bcs_neardist, self.team ).size == 1 )
        return;

    seq = scripts\engine\utility::random( [ "order_attack", "attacking", "suppressing" ] );
    _id_35DE402EFC5ACFB3::_id_D54E84A9513B0E45( "join_combat", seq, 0, 3, 15 );
}

entercombatevent()
{
