            case "c6":
                voicestring = "mummy";
                numvoices = 1;
                break;
            case "c8":
                voicestring = "butch";
                numvoices = 1;
                break;
            case "c12":
                voicestring = "swmpmon";
                numvoices = 1;
                break;
            default:
                voicestring = "enemy";
                numvoices = anim.numenemyvoices;
        }
    }

    voicenum = 1 + self getentitynumber() % numvoices;
    voicestring = voicestring + "_" + voicenum;
    soundalias = undefined;

