        }

        if ( !isdefined( anim.facial[a_state] ) )
            return;

        if ( isdefined( a_idx ) && a_idx >= 0 && a_idx < anim.facial[a_state].size )
            randidx = a_idx;
        else
            randidx = randomint( anim.facial[a_state].size );

        facialanim = anim.facial[a_state][randidx];
        self setanimknob( facialanim );
    }
