        return 1;
    }

    midorigin = ( eyeorigin + feetorigin ) * 0.5;

    if ( sighttracepassed( playereye, midorigin, 1, player, ai ) )
    {
        ai.playerseesme = 1;
        return 1;
    }

    ai.playerseesme = 0;
    return 0;
}
