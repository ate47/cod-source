quadrantanimweights( yaw )
{
    forwardweight = cos( yaw );
    leftweight = sin( yaw );
    result["front"] = 0;
    result["right"] = 0;
    result["back"] = 0;
    result["left"] = 0;

    if ( isdefined( self.alwaysrunforward ) )
