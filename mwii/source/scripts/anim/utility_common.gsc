            result["left"] = 1;
        else if ( leftweight < -1 * forwardweight )
            result["right"] = 1;
        else
            result["front"] = 1;
    }
    else
    {
        backweight = -1 * forwardweight;

        if ( leftweight > backweight )
            result["left"] = 1;
        else if ( leftweight < forwardweight )
            result["right"] = 1;
        else
            result["back"] = 1;
    }

    return result;
}

