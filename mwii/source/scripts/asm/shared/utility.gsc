getdamagedirstring()
{
    damagedir = -1 * self.damagedir;
    facingdir = anglestoforward( self.angles );
    dot = vectordot( facingdir, damagedir );

    if ( dot > 0.707 )
        return "front";
    else if ( dot < -0.707 )
        return "back";
    else
    {
        cross = vectorcross( facingdir, damagedir );

        if ( cross[2] > 0 )
            return "left";
        else
            return "right";
    }
}

gethumandamagedirstring()
{
    damagedir = -1 * self.damagedir;
    facingdir = anglestoforward( self.angles );
    dot = vectordot( facingdir, damagedir );

    if ( dot < -0.5 )
        return 1;

    return 0;
}

