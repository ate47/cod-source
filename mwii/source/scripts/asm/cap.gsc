            self.idle_bag.key = "wait";
            thread _id_399C8AD9434488E8();
        }
    }

    if ( !isdefined( self.idle_bag ) )
        return;

    if ( statename == "group_loop" && !istrue( self.idle_bag.isidle ) )
    {
        self.idle_bag.key = "idle";
        self.idle_bag.isidle = 1;
        propanim = level.scr_anim["idle_bag"]["idle"];
        self.idle_bag animrelative( "idle", self._blackboard._id_AD5EDA311C73F5D7 + offset, self._blackboard._id_66C82B7660F29059, propanim );
        self.idle_bag thread _id_C1D113F8B7F9000B();
    }
}

