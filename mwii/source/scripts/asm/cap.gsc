        return undefined;

    foreach ( aliasname in aliases )
    {
        if ( prefixlen < 0 || getsubstr( aliasname, 0, prefixlen ) == optionalprefix )
        {
            possible = possible + 1.0;
            chance = 1.0 / possible;

            if ( randomfloat( 1.0 ) <= chance )
                chosen = aliasname;
        }
    }

    return chosen;
}

