        Attachment attachment;
        // offset: 0x10, bitSize: 0x10(0x2 Byte(s)), array:0x2(hti:0xffff)
        uint:6 customTune[2];
        // offset: 0x20, bitSize: 0x20(0x4 Byte(s))
        int variantID;
        // offset: 0x40, bitSize: 0x1
        bool hasBPTune;
    };

    // bitSize: 0x380, members: 12
    struct WeaponSetup {
        // offset: 0x0, bitSize: 0x10(0x2 Byte(s))
        Camouflage camo;
        // offset: 0x10, bitSize: 0x20(0x4 Byte(s))
        uint paintJobID;
        // offset: 0x30, bitSize: 0x8(0x1 Byte(s))
        Reticle reticle;
        // offset: 0x38, bitSize: 0x10(0x2 Byte(s))
        CosmeticAttachment cosmeticAttachment;
        // offset: 0x48, bitSize: 0x50(0xa Byte(s)), array:0x5(hti:0xffff)
        Sticker sticker[5];
        // offset: 0x98, bitSize: 0xa0(0x14 Byte(s))
        string(20) blueprintName;
        // offset: 0x138, bitSize: 0x8(0x1 Byte(s))
        LoadoutWeapon weapon;
        // offset: 0x140, bitSize: 0x1f8(0x3f Byte(s)), array:0x7(hti:0xffff)
        AttachmentSetup attachmentSetup[7];
        // offset: 0x338, bitSize: 0x20(0x4 Byte(s))
        int lootItemID;
        // offset: 0x358, bitSize: 0x20(0x4 Byte(s))
        int variantID;
        // offset: 0x378, bitSize: 0x1
        bool blueprintTuned;
    };

    // bitSize: 0x1180, members: 1
    struct BlueprintWeaponEntry {
        // offset: 0x0, bitSize: 0x1180(0x230 Byte(s)), array:0x5(hti:0xffff)
