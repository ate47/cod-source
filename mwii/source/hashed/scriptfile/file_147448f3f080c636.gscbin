            {
                civ _meth_1C339DAABA3F71DB( 1 );
                civ _meth_106BCE0AEEE91D2C( scripts\common\utility::_id_B88F4E5BAFF057A9( 0.2 ) );
                timedelay = 0;

                if ( civ.headlooksetup.customtarget == 1 || notwithinfov )
                {
                    civ _meth_504A5E2DF31069A4();
                    civ _meth_1C339DAABA3F71DB( 0 );
                    civ.headlooksetup.customtarget = 2;
                    timedelay = randomintrange( 2000, 3000 );
