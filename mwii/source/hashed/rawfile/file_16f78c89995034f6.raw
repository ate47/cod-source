	level._effect[ "sniper_glint" ]        = LoadFx( "vfx/misc/scope_glint.vfx" );
	level._effect[ "vfx_muz_rpg_v" ]       = LoadFX( "vfx/iw8_mp/muzflash/vfx_muz_rpg_v.vfx" );
	level._effect[ "vfx_rpg_trail_2" ]     = LoadFX( "vfx/core/smktrail/vfx_rpg_trail_2.vfx" );
	level._effect[ "sniper_laser_bright" ] = loadFX( "vfx/iw9/core/lasers/vfx_hipaimlaser_red_bright.vfx" );
