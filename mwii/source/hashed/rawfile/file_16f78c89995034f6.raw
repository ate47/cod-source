	level._effect[ "mine_red_light" ]      = loadFX( "vfx/core/vehicles/aircraft_light_red_blink.vfx" );


	//---------------------VOLUMETRIC Height Fog--------------------------//
	SetDvar( #d"r_volumetricDepth", 4096 );
	SetDvar( #d"r_fogHeightMapFade"   , 1.0 );//Max Density
	SetDvar( #d"r_fogHeightMapNoiseDt", 60 );//Speed of fog Noise movement, larger number appears to be slower. 1 looks to repeat pattern every 1 second.
	SetDvar( #d"r_fogHeightMapNoiseScrollDir"     , "1 1 1" );//Noise scrolling vector direction in world space
	SetDvar( #d"r_fogHeightMapNoiseFlowmapUVScale", 0 );//broken - leave at 0
	SetDvar( #d"r_fogHeightMapNoiseUVScale", 600 ); //Size of fog chunks.  Bigger number is bigger chunks and gaps;
	SetDvar( #d"r_fogHeightMapNoiseBias", -0.1 ); //Max Density
	
	level thread envFires();
}

envFires()
{
	envFire_spawn( ( -43, 9313, 4819 ), 76 );	
}

envFire_spawn( org, radius )
{
	dmgTrig = Spawn( "trigger_radius", org, 0, radius, radius );
	dmgTrig.targetname = "fire_damage";
	dmgTrig thread envFire_playerDamageMonitor();
	
}

envFire_playerDamageMonitor()
{
	self endon( "death" );
	level endon( "game_ended" );
	
	while ( 1 )
	{
		self waittill( "trigger", ent );
		
		if ( isPlayer( ent ) )
		{
			thread envFire_playerdamage( ent );		
		}
	}
}

envFire_playerdamage( player )
{
	player endon( "disconnect" );

	if ( !isTrue( player.onFire ) )
	{
		player.onFire = true;
		player DoDamage( 45, player.origin, undefined, undefined, "MOD_TRIGGER_HURT" );
		wait 0.5;
		player.onFire = false;
	}

}
