(function (window) {
    const PLATFORM = WK.getProgramType(),
        LANGUAGE = WK.getEnvVar('language') || 'english',
        LANGUAGE_CODE = mapLanguageToLocaleCode(LANGUAGE),
        COUNTRY_CODE = WK.getEnvVar('location_country_code') || 'US',
        NA_COUNTRIES = {
            "US": "US",
            "CA": "CA",
            "MX": "MX"
        },
        EU_COUNTRIES = {
            "AT": "AT",
            "BB": "BB",
            "BE": "BE",
            "BG": "BG",
            "BY": "BY",
            "CH": "CH",
            "CZ": "CZ",
            "DE": "DE",
            "DK": "DK",
            "EE": "EE",
            "ES": "ES",
            "FI": "FI",
            "FR": "FR",
            "GB": "GB",
            "GE": "GE",
            "GR": "GR",
            "IS": "IS",
            "IT": "IT",
            "LU": "LU",
            "NL": "NL",
            "NO": "NO",
            "PL": "PL",
            "PT": "PT",
            "RO": "RO",
            "RS": "RS",
            "RU": "RU",
            "SI": "SI",
            "SK": "SK",
            "UA": "UA"
        },
        IS_PS4 = PLATFORM === 'PS4',
        isCrossConfirm = WK.isCrossConfirm();     
        // PAGE_CONTEXT = "eula_reaccess";        
        PAGE_CONTEXT = WK.getEnvVar('page_context') || "eula";    
    (IS_4K = WK.getEnvVar('resolution') === '0'),
        (SCROLL_COMPLETE = {}),
        (ACCEPTANCES = {}),
        (IS_KO = WK.getEnvVar('is_korean_account') || false),
        (BUTTONS = ['decline', 'accept']),
        (REGION_AUX_ARTIFACT_KEYS = ['pii']),
        (ARTIFACT_TABNAME_MAP = {
            eula: 'eula',
            privacyPolicy: 'privacyPolicy',
            tou: 'tou',
        }),
        (EULA = {}),
        (REGION_SPECIFIC_ARTIFACTS = {
            KO: {
                artifactName: 'pii',
                artifactTitle: 'PII',
            },
            KR: {
                artifactName: 'pii',
                artifactTitle: 'PII',
            }
        }),
        MODAL_COPY_MAP = {
            eula: "acceptEula",
            privacyPolicy: "acceptPrivacyPolicy",
            tou: "acceptTou",
            pii: "acceptPii"
        },
        // default to 2 locally === battlenet
        ACCOUNT_TYPE = WK.getEnvVar('account_type') || 2;
        //nodes
        (ackBtn = document.getElementById('accept')),
        (declineBtn = document.getElementById('decline')),
        (CONTROL_BTNS = document.getElementById('controls').children),
        (MODAL_CONTROL_BTNS = document.getElementById('modal-btns').children),
        (SCROLL_WINDOW = document.getElementById('acceptances-wrapper')),
        (SCROLL_WINDOW_HEIGHT = SCROLL_WINDOW.offsetHeight),
        controllerHints = document.querySelectorAll('.controller-hints'),
        CONTINENT = undefined,
        IS_SONY = PLATFORM === 'PS4' || PLATFORM === 'PS5',
        callCount = 0;

        const soundMap = {
            SOUND_DEFAULT: 7,
            SOUND_ACTION: 0,
            SOUND_MENU_GO_BACK: 1,
            SOUND_TAB_CHANGED: 2,
            SOUND_LIST_UP: 3,
            SOUND_LIST_DOWN: 4,
            SOUND_LIST_LEFT: 5,
            SOUND_LIST_RIGHT: 6,
            SOUND_GAIN_FOCUS: 7,
            SOUND_ACTION_SAME_SCREEN: 8,
            SOUND_ACTION_NEW_SCREEN: 9,
        };
        const PC = 'PC';
        const PS = 'PS4';
        const XB = 'XBOXSX';

    EULA.ACCEPTED_ARTIFACTS = {};
    (EULA.CURRENT_ARTIFACT_MAP = {}),
        (BTN_MAP = {
            1: 'left',
            2: 'right',
            3: 'up',
            4: 'down',
            5: 'primary',
            6: 'secondary',
            7: 'xbX_psSquare',
            8: 'xbY_psTriangle',
            9: 'lb',
            10: 'rb',
            11: 'left_trigger',
            12: 'right_trigger',
            13: 'lStick_pressed',
            14: 'rStick_pressed',
        });

    let TAB_INDEX = 0,
        ACTIVE_BUTTON_INDEX = 1,
        MODAL_ACTIVE_BUTTON_INDEX = 1,
        isFocused = false,
        isExpanded = false,
        ARTIFACT_KEYS = ['eula', 'eulaAddOn', 'privacyPolicy', 'privacyPolicyAddOn', 'tou', 'touAddOn'],
        TABS = [],
        controllerType = PC,
        gamePad = WK.lastInputGamepad(),
        scrollInterval = undefined,
        lastInputDevice = undefined,
        lastInputGamepad = undefined,
        mouseDown = false,
        interval = 0;
        isArabic= false,
        mouseDown = false;

    function checkLastInputs() {
        lastInputDevice = WK.lastInputDevice();
        lastInputGamepad = WK.lastInputGamepad();
        WK.handleInputDevice(lastInputDevice, lastInputGamepad);
    };

    function setContinent(countryCode) {
        if(IS_SONY) {
            if(WK.getEnvVar("is_sony_na")) {
                return "na";
            } else if(WK.getEnvVar("is_sony_eu")) {
                return "eu";
            } else {
                return;
            }
        }
        if(!NA_COUNTRIES[countryCode] && !EU_COUNTRIES[countryCode]) return;
        if(NA_COUNTRIES[countryCode]){
            return "na";
        } else if (EU_COUNTRIES[countryCode]) {
            return "eu";
        }
    };

    if (WK.isRtl(LANGUAGE)) {
        isArabic = true;
        document.body.setAttribute('dir', 'rtl');
        document.body.classList.add('arabic')
    }

  
    WK.Telescope_CB_ControllerButtonEvent = (eventType, buttonType, buttonId) => {
        //eventType 0 = release, 1 = press
        if(!mouseDown) {
            handleInput(BTN_MAP[eventType] || eventType, buttonType, buttonId);
        }
    }

    function Telescope_CB_LoseFocus() {
        handleFocus('loseFocus');
    }

    function Telescope_CB_GainFocus() {
        handleFocus('gainFocus');
    }

    window.Telescope_CB_GainFocus = Telescope_CB_GainFocus;
    window.Telescope_CB_LoseFocus = Telescope_CB_LoseFocus;
    window.Telescope_CB_ControllerButtonEvent = WK.Telescope_CB_ControllerButtonEvent;
    window.Telescope_CB_LastInputDeviceUpdated = function Telescope_CB_LastInputDeviceUpdated(device, gamepad) {
        WK.handleInputDevice(device, gamepad);
    }

    function getAcceptedArtifactAndVersion(section, key) {
        if (window.Telescope_API_GetStorageValue) {
            return Telescope_API_GetStorageValue(section, key);
        }
        // placeholder for now
        return key, 0;
    }

    function sendAcceptedArtifactAndVersion(artifact, version, allCompleted) {
        if (allCompleted) {
            WK.telescopeLoadComplete();
        }
        return Telescope_API_AcceptEULA(artifact, version, allCompleted);
    }

    function setCurrentArtifactConfig() {
        // CURRENT_ARTIFACT_DATA is defined in the JSON data that is being called.
        return CURRENT_ARTIFACT_DATA;
    }

    function mapLanguageToLocaleCode(language) {
        return WK.languageToLocale[language] ? WK.languageToLocale[language] : 'en';
    }

    function replaceChild(parent, newNode) {
        if (parent) {
            removeAllChildNodes(parent);
            parent.appendChild(newNode);
        }
    }

    function playSoundForUi() {
        if (typeof Telescope_API_TriggerSound !== 'undefined') {
            Telescope_API_TriggerSound(soundMap.SOUND_DEFAULT);
        }
        WK.printLine(`playing sound index: 7 (focus)`);
    };


    const loadLocaleJsonScript = (locale = 'en', platform = 'PC', successCallback) => {
        var script = document.createElement('script'),
            isLocal = window.location.href.indexOf('/motd-t9/') >= 0 ? true : false;
        script.src = isLocal ? `regions/${platform.toLowerCase()}/${locale}/eula.json` : `${platform.toLowerCase()}/eula.json`;
        document.body.appendChild(script);

        script.onload = () => {
            successCallback();
        };
        script.onerror = (e) => {
            if(callCount  < 5) {
                WK.printLine(`Error loading source ${script.src}. Defaulting to english`);
                loadLocaleJsonScript('en', 'pc', successCallback);
                callCount++
            } else {
                WK.printLine(`Error loading source ${script.src}. Quitting JSON load`);
            }
        };
    };

    WK.handleInputDevice = (device, gamepad) => {
        if (device === 0) {
            controllerType = gamepad == 2 ? XB : gamepad == 3 ? PS : PC;
        } else if (device == 1 || device == 2 || device == 3) {
            controllerType = PC;
        }

        if (controllerType === PS) {
            controllerHints.forEach(hint => {hint.classList.remove('is-pc');})
            setControllerHintSvg(controllerType);
        } else if (controllerType === XB) {
            WK.printLine('XBOX CONTROLLER')
            controllerHints.forEach(hint => {
                WK.printLine(`${hint.dataset.controllerString} REMOVED isPC`)
                hint.classList.remove('is-pc');
            })
            setControllerHintSvg(controllerType);
        } else {
            controllerHints.forEach(hint => {hint.classList.add('is-pc');})
        }

    }
    //init
    const init = () => {
        WK.printLine('INIT EULA LOGIC');
        CONTINENT = setContinent(COUNTRY_CODE);
        WK.printLine('country code ' + COUNTRY_CODE)
        WK.printLine('CONTINENT ' + CONTINENT);
        WK.printLine('SONY ' + IS_SONY)
        if(WK.is4k()) {
            document.documentElement.classList.add('is4k');
        }
        if (IS_KO) {
            ARTIFACT_TABNAME_MAP.pii = 'pii';
            ARTIFACT_KEYS.push('pii');
        }
        EULA.ACCEPTED_ARTIFACTS = buildConsoleAcceptedArtifactConfig(ARTIFACT_KEYS);
        loadLocaleJsonScript(LANGUAGE_CODE, PLATFORM, handleLoadSuccess);
    };

    const startEula = () => {
        WK.printLine('STARTING EULA ');       
        document.documentElement.lang = LANGUAGE_CODE;
        setScreen();
        setBtnId(PAGE_CONTEXT);
        setBtnCopy('controls');
        setModalCopy();
        setScrollCopy();
        setControllerHintCopy();
        clickHandlers();
        mouseHandlers();
        scrollHandlers();
        checkLastInputs();
        toggleActiveBtn(1, 0, CONTROL_BTNS);
        if (typeof Telescope_API_LoadComplete !== 'undefined') {
            Telescope_API_LoadComplete(true);
            Telescope_API_SetDisplayMode(1);
        } else {
            WK.printLine('telescope not available');
        }

    };

    const handleInput = (eventType, buttonType, buttonId) => {
        let btn = BTN_MAP[buttonType];
        if(typeof eventType === 'string') {
            onPress(btn || eventType, buttonId); 
            return;
        }
        // eventType 0 = release, 1 = press
        // passing in eventType for browser testing
        if (eventType === 1) {
            onPress(btn || eventType, buttonId);
            // passing in eventType for browser testing
        } else if (eventType === 0) {
            onRelease(btn || eventType, buttonId);
        }
    };

    const onPress = (btn, buttonId) => {
        if (isModalShown()) {
            switch (btn) {
                case 'left':
                    // if(isArabic) {
                        // toggleActiveBtn(MODAL_ACTIVE_BUTTON_INDEX + 1, MODAL_ACTIVE_BUTTON_INDEX, MODAL_CONTROL_BTNS);
                    // } else {
                        toggleActiveBtn(MODAL_ACTIVE_BUTTON_INDEX - 1, MODAL_ACTIVE_BUTTON_INDEX, MODAL_CONTROL_BTNS);
                    // }
                    
                    playSoundForUi();
                    break;
                case 'right':
                    // if(isArabic) {
                    //     toggleActiveBtn(MODAL_ACTIVE_BUTTON_INDEX - 1, MODAL_ACTIVE_BUTTON_INDEX, MODAL_CONTROL_BTNS);
                    // } else {
                        toggleActiveBtn(MODAL_ACTIVE_BUTTON_INDEX + 1, MODAL_ACTIVE_BUTTON_INDEX, MODAL_CONTROL_BTNS);
                    // }                    
                    playSoundForUi();
                    break;
                case 'primary':
                    if(isCrossConfirm || !IS_PS4) { 
                        clickActiveBtn('modal-btns');
                        playSoundForUi();
                    } else {
                        closeDeclineModal();
                        playSoundForUi();
                    }
                    break;
                case 'secondary':
                    if(!isCrossConfirm && IS_PS4) {
                        clickActiveBtn('modal-btns');
                        playSoundForUi();
                    } else {
                        closeDeclineModal();
                        playSoundForUi();
                    }                                        
            }
        } else {
            switch (btn) {
                case 'up':
                    if(buttonId === 1003) {
                        interval++;
                        scrollInterval = setInterval(handleScroll(btn, interval), 500);
                    }                    
                    break;
                case 'down':
                    if(buttonId === 1004) {
                        interval++;
                        scrollInterval = setInterval(handleScroll(btn, interval), 500);
                    }                    
                    break;
                case 'left':
                    // if(isArabic) {
                    //     toggleActiveBtn(ACTIVE_BUTTON_INDEX + 1, ACTIVE_BUTTON_INDEX, CONTROL_BTNS);
                    // } else {
                        toggleActiveBtn(ACTIVE_BUTTON_INDEX - 1, ACTIVE_BUTTON_INDEX, CONTROL_BTNS);
                    // }
                    playSoundForUi();
                    break;
                case 'right':                    
                    // if(isArabic) {
                    //     toggleActiveBtn(ACTIVE_BUTTON_INDEX - 1, ACTIVE_BUTTON_INDEX, CONTROL_BTNS);
                    // } else {
                        toggleActiveBtn(ACTIVE_BUTTON_INDEX + 1, ACTIVE_BUTTON_INDEX, CONTROL_BTNS);
                    // }
                    playSoundForUi();
                    break;
                case 'primary':
                    if(isCrossConfirm || !IS_PS4) { 
                        clickActiveBtn('controls');
                        playSoundForUi();
                    } else {
                        openDeclineModal();
                        playSoundForUi();
                    }
                    break;
                case 'secondary':
                    if(!isCrossConfirm && IS_PS4) {
                        clickActiveBtn('controls');
                        playSoundForUi();
                    } else {
                        openDeclineModal();
                        playSoundForUi();
                    }
            }
        }
    }

    const onRelease = (btn, buttonId) => {
        if (isModalShown()) {
        } else {            
            switch (btn) {
                case 'up':   
                    if(buttonId === 1003) {
                        interval = 0;              
                        clearInterval(scrollInterval);
                    }                
                    break;
                case 'down':
                    if(buttonId === 1004) {
                        interval = 0;
                        clearInterval(scrollInterval);
                    }                
            }
        }
    };

    const clickActiveBtn = (containerId) => {
        let el = document.getElementById(containerId),
            activeEl;

        for (btn of el.children) {
            if (btn.classList.contains('active')) {
                activeEl = btn;
            }
        }

        if (activeEl) {
            activeEl.click();
        }
    };

    const isModalShown = () => {
        return !document.querySelector('.modal-container').classList.contains('hidden');
    };

    const switchTabs = () => {
        let oldTab = TABS[TAB_INDEX];
        document.querySelector(`.artifact-nav-wrapper .${oldTab}`).classList.add('read');

        if (TAB_INDEX + 1 >= TABS.length) {
            finishSession();
            return;
        }

        document.getElementById(oldTab).classList.remove('active');
        document.querySelector(`.artifact-nav-wrapper .${oldTab}`).classList.remove('active');
        TAB_INDEX += 1;
        let newTab = TABS[TAB_INDEX];
        document.getElementById(newTab).classList.add('active');
        document.querySelector(`.artifact-nav-wrapper .${newTab}`).classList.add('active');
        setModalCopy();
        setScreen();
    };

    const accept = () => {
        let version = ackBtn.getAttribute('data-artifact-version'),
            key = ackBtn.getAttribute('data-artifact-key'),
            isLastArtifact = false;

        if (TAB_INDEX >= TABS.length - 1) isLastArtifact = true;
        if (SCROLL_COMPLETE[TABS[TAB_INDEX]] || PAGE_CONTEXT === 'eula_reaccess') {
            ACCEPTANCES[TABS[TAB_INDEX]] = true;
            WK.printLine('accepted artifact');

            //acept eula
            if (window.Telescope_API_AcceptEULA && (PAGE_CONTEXT !== 'eula_reaccess')) {
                sendAcceptedArtifactAndVersion(key, version, isLastArtifact);
            };
            if (isLastArtifact) {
                Telescope_API_SetDisplayMode(0);
            };
            switchTabs();
            if(scrollInterval !== undefined) {
                clearInterval(scrollInterval);                
            };
            interval = 0;
            setBtnCopy('controls');
            setAcceptAttributes();
            setCurrentArtifactDisclaimer();            
            if(PAGE_CONTEXT !== 'eula_reaccess') {
                setAckBtnText();
                toggleScrollBanner(true);
            };
            
        }
        return;
    };

    const setModalCopy = () => {
        let modalHeader = document.querySelector('#modal .modal-header-container p'),
            modalCopy = document.querySelector('#modal .modal-copy-container p'),
            currArtifactKey = TABS[TAB_INDEX],            
            artifactCopy = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE][currArtifactKey] : '',
            headerPrefix,
            dictKey = MODAL_COPY_MAP[currArtifactKey];

        if(dictKey) {
            modalHeader.textContent = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE][dictKey] : `${WK.i18n[LANGUAGE].accept} ${artifactCopy}`;            
        } else {
            if (currArtifactKey === 'eula' || currArtifactKey === 'tou') {
                headerPrefix = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE].accept : 'Accept';
            } else {
                headerPrefix = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE].acknowledge : 'Acknowledge';
            }
            modalHeader.textContent = `${headerPrefix} ${artifactCopy}`;
        }

        modalCopy.textContent = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE][`${currArtifactKey}Modal`]: 'To play Call of Duty, you must accept.';
        setBtnCopy('modal-btns');
    };

    const setBtnCopy = (containerId) => {
        let btns = document.getElementById(containerId);

        for (btn of btns.children) {
            let id = btn.dataset.btnCopy;
            btn.textContent = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE][id] : '';
        }
    };

    const setBtnId = (pageContext) => {
        if(pageContext === 'eula') {
            ackBtn.dataset.btnCopy = "accept";
            declineBtn.dataset.btnCopy = "decline";
        } else {
            ackBtn.dataset.btnCopy = "continue";
            declineBtn.dataset.btnCopy = "back";
        }
        
    }
    
    const setScrollCopy = () => {
        let scrollCopy = document.querySelector('.scroll-banner p');

        scrollCopy.innerHTML = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE].scrollDown : 'Scroll<br><b>Down</b>';
    };

    const setControllerHintCopy = () => {
        let controls = document.querySelectorAll('.controller-hints .control');

        controls.forEach(control => {
            let dictKey = control.dataset.controllerString;
            let p = control.querySelector(".copy");
            p.textContent =  WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE][dictKey] : '';
        })
    };

    const setControllerHintSvg = (platform) => {
        if(platform === PC) return;
        let controls = document.querySelectorAll('.controller-hints .control');

        controls.forEach(control => {
            let div = control.querySelector(".icon"),
                buttonId = div.dataset.iconString;

                let svgPath = WK.utils.getControllerButtonSvg(platform, isCrossConfirm, buttonId);
                // need to handle the select separately since it will be seen on the UI in modal and on page
                if(buttonId === 'select') {
                    if(div.childElementCount > 0) {
                        div.removeChild(div.firstChild);
                    }
                    div.append(svgPath.cloneNode(true));
                } else {
                    if(div.childElementCount > 0) {
                        div.removeChild(div.firstChild);
                    }
                    div.append(svgPath);
                }
                
        })
    }

    const setAcceptAttributes = () => {
        let currTab = TABS[TAB_INDEX],
            currTabEl = document.querySelector(`#acceptances-wrapper #${currTab}`),
            currArtifactVersion = currTabEl.getAttribute('data-artifact-version'),
            currArtifactKey = currTabEl.getAttribute('data-artifact-key');

        ackBtn.dataset.artifactVersion = currArtifactVersion;
        ackBtn.dataset.artifactKey = currArtifactKey;
    };

    const setCurrentArtifactDisclaimer = () => {
        let currTab = TABS[TAB_INDEX],
            disclaimerContainer = document.querySelector('.copy-container .artifact-disclaimer'),
            dictKey = `${currTab}Disclaimer`;

        disclaimerContainer.textContent = WK.i18n[LANGUAGE][dictKey] ? WK.i18n[LANGUAGE][dictKey] : "";
    };

    const setAckBtnText = () => {
        const currTab = TABS[TAB_INDEX];
        let ackText = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE].acknowledge : 'Acknowledge';
        if (currTab === 'eula' || currTab === 'tou') {
            ackText = WK.i18n[LANGUAGE] ? WK.i18n[LANGUAGE].accept : 'Accept';
        }
        ackBtn.textContent = ackText;
    };

    const openDeclineModal = () => {
        document.querySelector('.content-right').style.pointerEvents = 'none';
        document.querySelector('.modal-container').classList.remove('hidden');        
        document.querySelector('#ok').focus();
        document.body.classList.add('modal-open');
    };

    const closeDeclineModal = () => {
        document.querySelector('.content-right').style.pointerEvents = 'auto';
        document.querySelector('.modal-container').classList.add('hidden');        
        toggleActiveBtn(1, 0, MODAL_CONTROL_BTNS);
        document.body.classList.remove('modal-open');
    };

    const decline = () => {
        ACCEPTANCES[TABS[TAB_INDEX]] = false;
        WK.printLine('declined artifact');
        // if (window.Telescope_API_SetDisplayMode) {
        //     Telescope_API_SetDisplayMode(0);
        // }
    };

    const finishSession = () => {
        for (let acceptance in ACCEPTANCES) {
            if (!ACCEPTANCES[acceptance]) {
                return false;
            }
        }
        WK.printLine('FINISH SESSION');
    };

    const mouseUpListen = () => {
        mouseDown = false;
    };

    const mouseDownListen = () => {
        mouseDown = true;
    }; 

    const clickHandlers = () => {
        document.getElementById('accept').addEventListener('click', (e) => {
            if (e.target.classList.contains('disabled')) {
                toggleScrollBanner(false);
                e.target.classList.add('flash')
                setTimeout(() => {
                    e.target.classList.remove('flash')
                }, 100)
            } else {
                accept();
            }
        });
        document.getElementById('decline').addEventListener('click', (e) => {
            if(PAGE_CONTEXT === 'eula_reaccess') {
                decline();
                return;
            }
            openDeclineModal();
        });
        // document.getElementById('quit').addEventListener('click', (e) => {
        //     decline();
        // });
        document.getElementById('ok').addEventListener('click', (e) => {
            closeDeclineModal();
        });

        document.querySelector('.modal-container').addEventListener('click', (e) => {
            let modalContainer = document.querySelector('.modal-container');

            if(e.target === modalContainer) {
                closeDeclineModal();
            }
        })
    };

    const mouseHandlers = () => {
        document.getElementById('accept').addEventListener('mouseover', (e) => {
            if (e.target.classList.contains('disabled')) {
                return;
            }
            toggleActiveBtn(1, 0, CONTROL_BTNS);
            // e.target.classList.add('active');
            // document.getElementById('decline').classList.remove('active');
        });
        document.getElementById('decline').addEventListener('mouseover', (e) => {
            // e.target.classList.add('active');
            // document.getElementById('accept').classList.remove('active');
            toggleActiveBtn(0, 1, CONTROL_BTNS);
        });
        // document.getElementById('quit').addEventListener('mouseover', (e) => {
        //     // e.target.classList.add('active');
        //     // document.getElementById('ok').classList.remove('active');
        //     toggleActiveBtn(0, 1, MODAL_CONTROL_BTNS);
        // });
        document.getElementById('ok').addEventListener('mouseover', (e) => {
            // e.target.classList.add('active');
            // document.getElementById('quit').classList.remove('active');
            toggleActiveBtn(1, 0, MODAL_CONTROL_BTNS);
        });

        document.getElementById('accept').addEventListener('mouseleave', (e) => {
            e.target.classList.remove('active');
        });
        document.getElementById('decline').addEventListener('mouseleave', (e) => {
            e.target.classList.remove('active');
        });
        // document.getElementById('quit').addEventListener('mouseleave', (e) => {
        //     e.target.classList.remove('active');
        //     document.getElementById('quit');
        // });
        document.getElementById('ok').addEventListener('mouseleave', (e) => {
            if (isModalShown()) {
                e.target.classList.remove('active');
            }
        });

        document.getElementById("acceptances-wrapper").addEventListener('mousedown', mouseDownListen);
        document.getElementById("acceptances-wrapper").addEventListener('mouseup', mouseUpListen);

    };
    const toggleScrollBanner = (isNewTab) => {
        let banner = document.querySelector('#acceptances-wrapper .scroll-banner');
        let currArtifact = document.querySelector('#acceptances-wrapper .acceptance.active');
        if (isNewTab) {
            banner.classList.remove('active');
        } else {
            if (!banner.classList.contains('active')) {
                banner.classList.add('active');
                currArtifact.classList.add('active-banner');
            }
        }
    };

    const scrollHandlers = () => {
        SCROLL_WINDOW.addEventListener('scroll', (e) => {
            //scrollHeight - 1 px offset for sizes on browser
            if (SCROLL_WINDOW.offsetHeight + SCROLL_WINDOW.scrollTop >= SCROLL_WINDOW.scrollHeight - 1) {
                ackBtn.classList.remove('disabled');
                if(ACTIVE_BUTTON_INDEX != 0) {
                    ackBtn.classList.add('active');
                };
                ackBtn.focus();
                toggleReadState(true);
            }
        });
    };

    const handleScroll = (btn, interval) => {
        
        if (btn === 'up') {
            if(interval > 5) {
                SCROLL_WINDOW.scrollTo(0, 0);
            } else {
                SCROLL_WINDOW.scrollBy(0, (500 * interval) * -1);
            }
        } else if (btn === 'down') {
            if(interval > 5) {
                SCROLL_WINDOW.scrollTo(0, SCROLL_WINDOW.scrollHeight);
            } else {
                SCROLL_WINDOW.scrollBy(0, 500 * interval);
            }
            
        }
    };

    const toggleReadState = (isReady) => {
        SCROLL_COMPLETE[TABS[TAB_INDEX]] = isReady;
        toggleActiveBtn(1, 0, CONTROL_BTNS);
        toggleScrollBanner(true)
    };

    const setScreen = () => {
        if(PAGE_CONTEXT === 'eula_reaccess') { 
            return;
        }
        let activeArtifactContainerHeight = document.querySelector('.acceptance.active').offsetHeight;

        ackBtn.classList.add('disabled');
        SCROLL_WINDOW.scrollTo(0, 0);
        if (activeArtifactContainerHeight < SCROLL_WINDOW_HEIGHT) {
            ackBtn.classList.remove('disabled');
            toggleReadState(true);
        }
    };

    const isAllArtifactsAccepted = (artifacts) => {
        return artifacts.every((artifact) => artifact.endsWith('AddOn'));
    };

    const handleLoadSuccess = () => {
        EULA.CURRENT_ARTIFACT_MAP = setCurrentArtifactConfig();
        let artifactsList = buildArtifactList(EULA.ACCEPTED_ARTIFACTS, EULA.CURRENT_ARTIFACT_MAP);
        if ((!isAllArtifactsAccepted(artifactsList) && (PAGE_CONTEXT === 'eula' || PAGE_CONTEXT === 'browser')) || PAGE_CONTEXT === 'eula_reaccess') {
            WK.printLine(`EULA PAGE CONTEXT ${PAGE_CONTEXT}`)
            let artifactData = PAGE_CONTEXT === 'eula_reaccess' ? filterRegionArtifacts(EULA.CURRENT_ARTIFACT_MAP) : getArtifactContents(artifactsList, EULA.CURRENT_ARTIFACT_MAP);
            // let aggregatedData = aggregateArtifacts(artifactData);            
            if (artifactData) {
                let articleWrapper = document.getElementById('acceptances-wrapper'),
                    navWrapper = document.querySelector('.artifact-nav-wrapper'),
                    isFirst = true,
                    index = 0;

                TABS = setTabsArr(artifactData);
                for (artifact in artifactData) {
                    let section = createArticleEl(artifact, isFirst);
                    let tabBtn = createItemStep(artifact, index);
                    index++;
                    isFirst = false;
                    articleWrapper.append(section);
                    navWrapper.append(tabBtn);
                    if (index < TABS.length) {
                        let borderEl = createBorderEl();
                        navWrapper.append(borderEl);
                    }
                }
                populateUiEls(artifactData);
                setAcceptAttributes();
                setCurrentArtifactDisclaimer();
                startEula();
                if(PAGE_CONTEXT !== 'eula_reaccess') {
                    setAckBtnText();
                }
            }
        } else {
            WK.printLine('exiting EULA. All artifacts up to date');
            if (window.Telescope_API_SetDisplayMode) {
                sendAcceptedArtifactAndVersion('', '', true);
                Telescope_API_SetDisplayMode(0);
            }
            document.body.style.background = 'transparent';
            document.querySelectorAll('button').forEach((btn) => (btn.style.display = 'none'));
        }
    };
    const buildConsoleAcceptedArtifactConfig = (artifacts) => {
        let acceptedArtifacts = {};
        artifacts.forEach((artifact) => {
            acceptedArtifacts[artifact] = getAcceptedArtifactAndVersion('EULA', artifact);
        });
        return acceptedArtifacts;
    };

    const buildArtifactList = (acceptedArtifacts, currentArtifacts) => {
        let artifactsListToShow = [];
        let filteredArtifacts = filterRegionArtifacts(currentArtifacts);

        for (const currentArtifact in filteredArtifacts) {
            if (!acceptedArtifacts[currentArtifact]) {
                artifactsListToShow.push(currentArtifact);
            } else {
                if (
                    filteredArtifacts[currentArtifact].version &&
                    filteredArtifacts[currentArtifact].version > acceptedArtifacts[currentArtifact]
                ) {
                    artifactsListToShow.push(currentArtifact);
                }
            }
        }
        return artifactsListToShow;
    };

    const getArtifactContents = (artifactsList, currentArtifactMap) => {
        let artifactDataMap = {};
        artifactsList.forEach((artifact) => {
            WK.printLine(artifact);
            artifactDataMap[artifact] = currentArtifactMap[artifact];
        });
        return artifactDataMap;
    };

    const createArticleEl = (artifact, isFirst) => {
        let section = document.createElement('section'),
            article = document.createElement('article');

        section.setAttribute('id', artifact);
        section.setAttribute('class', 'acceptance');
        if (isFirst) section.classList.add('active');
        section.appendChild(article);

        return section;
    };
    const createItemStep = (artifact, index) => {
        let item = document.createElement('div'),
            stepNum = document.createElement('p');
        artfifactName = document.createElement('p');

        item.classList.add('artifact-item', artifact);
        if (index === 0) {
            item.classList.add('active');
        }
        item.dataset.btnIndex = index;

        artfifactName.classList.add('artifact-name');
        artfifactName.textContent = WK.i18n[LANGUAGE][ARTIFACT_TABNAME_MAP[artifact]]
            ? WK.i18n[LANGUAGE][ARTIFACT_TABNAME_MAP[artifact]]
            : ARTIFACT_TABNAME_MAP[artifact];

        stepNum.classList.add('counter');
        stepNum.textContent = index + 1;

        item.appendChild(stepNum);
        item.appendChild(artfifactName);

        return item;
    };

    const createBorderEl = () => {
        let container = document.createElement('div');

        container.classList.add('step-line');

        return container;
    };
    const populateUiEls = (data) => {
        let wrapper = document.querySelectorAll('section.acceptance');
        wrapper.forEach((tab) => {
            let tabId = tab.getAttribute('id');
            let el = document.getElementById(tabId);
            el.dataset.artifactKey = tabId;
            el.dataset.artifactVersion = data[tabId].version;
            let article = el.querySelector('article');
            article.innerHTML = data[tabId].text;

            if(IS_SONY && CONTINENT && tabId === 'eula' ) {
                article.innerHTML += data[tabId].sonyAddOn[CONTINENT];
            }

            if(tabId === 'pii' && (ACCOUNT_TYPE === 2 || ACCOUNT_TYPE === 8)) {
                if(ACCOUNT_TYPE === 2) {
                    article.innerHTML += data[tabId].battlenet;
                } else {
                    article.innerHTML += data[tabId].steam;
                }
            }
        });
    };

    const toggleActiveBtn = (btnIndex, activeBtnIndex, btnSectionEls) => {
        let oldIndex = activeBtnIndex;
        if (btnSectionEls.ok) {
            MODAL_ACTIVE_BUTTON_INDEX = setActiveBtnIndex(btnIndex);
        } else {
            ACTIVE_BUTTON_INDEX = setActiveBtnIndex(btnIndex);
        }

        if (btnIndex > btnSectionEls.length - 1) {
            if (btnSectionEls.length === 1) {
                btnIndex = 0;
            } else {
                btnIndex = 1;
            }
        } else if (btnIndex < 0) {
            btnIndex = 0;
        }

        btnSectionEls[oldIndex] && btnSectionEls[oldIndex].classList.remove('active');
        btnSectionEls[btnIndex] &&  btnSectionEls[btnIndex].classList.add('active');
    };

    const setActiveBtnIndex = (delta) => {
        if (delta > 0) {
            return 1;
        } else {
            return 0;
        }
    };

    const handleAckPress = (activeBtnIndex, btnSectionEls) => {
        btnSectionEls[activeBtnIndex].click();
    };

    const handleFocus = (i) => {
        switch (i) {
            case 'gainFocus':
                setFocused(true);
                break;
            case 'loseFocus':
                setFocused(false);
                break;
        }
    };

    const setFocused = (f) => {
        isFocused = f;
        let body = document.body;

        if (f) {
            if (!isExpanded) {
                body.classList.add('focused');
                playSoundForUi();
            }
        } else {
            if (!isExpanded) {
                body.classList.remove('focused');
                playSoundForUi();
            }
        }
    };

    const deleteArtifactByKey = (data, key) => {
        delete data[key];
    };

    const filterRegionArtifacts = (artifacts) => {
        let filteredArtifacts = Object.assign({}, artifacts);

        if (!IS_KO) {
            //delete the keys
            REGION_AUX_ARTIFACT_KEYS.forEach((key) => {
                deleteArtifactByKey(filteredArtifacts, key);
            });
        }
        if (IS_KO) {
            // let keyName = REGION_SPECIFIC_ARTIFACTS[COUNTRY_CODE].artifactName;
            REGION_AUX_ARTIFACT_KEYS.forEach((key) => {
                if (key !== 'pii') {
                    deleteArtifactByKey(filteredArtifacts, key);
                }
            });
        }

        return filteredArtifacts;
    };

    const setTabsArr = (tabs) => {
        let tabsArr = [];
        let keys = Object.keys(tabs);
        keys.forEach((key) => {
            tabsArr.push(key);
        });
        return tabsArr;
    };

    init();
})(window);
