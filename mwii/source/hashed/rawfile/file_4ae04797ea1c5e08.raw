	level._effect[ "sniper_laser_brightx" ] = loadFX( "vfx/iw9/core/lasers/vfx_hipaimlaser_red_xbright.vfx" );

	level._effect[ "stinger_trail" ]  = loadFX( "vfx/iw9/level/gunship/vfx_gunship_stingertrail.vfx" );

	level._effect[ "mine_red_light" ]    = loadFX( "vfx/core/vehicles/aircraft_light_red_blink.vfx" );

	level._effect[ "heli_comp_cluster_1" ] = loadFX( "vfx/iw9/cp/vfx_cp_heli_escort_comp_cluster_1.vfx" );
	level._effect[ "heli_comp_cluster_2" ] = loadFX( "vfx/iw9/cp/vfx_cp_heli_escort_comp_cluster_2.vfx" );
