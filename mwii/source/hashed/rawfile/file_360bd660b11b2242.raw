	//Volumetric Particles Dvars

	SetDvar( #d"r_volumetricDepth"					, 8000 );//Sets the draw distance of the volumetrics
	SetDvar( #d"r_fogHeightMapNoiseDt"       		, 100 );//Speed of fog Noise movement, larger number is faster.
	SetDvar( #d"r_fogHeightMapNoiseScrollDir"		, "-1 0 0" );//Noise scrolling vector direction in world space;
	SetDvar( #d"r_fogHeightMapNoiseFlowmapUVScale"	, 0 );//broken - leave at 0
	SetDvar( #d"r_fogHeightMapNoiseUVScale"       	, 2000 );//Size of fog chunks.  Bigger number is bigger chunks and gaps;
	SetDvar( #d"r_fogHeightMapFade"               	, 0.145 );//Max Density
	SetDvar( #d"r_fogHeightMapNoiseBias"			, -0.125 );// Controls noise detail
	
