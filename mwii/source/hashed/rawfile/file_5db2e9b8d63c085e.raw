main()
{
	//---------------------VOLUMETRIC Height Fog--------------------------//
	SetDvar( #d"r_volumetricDepth", 4096 );
	SetDvar( #d"r_fogHeightMapFade"               , 1.0 );//Max Density
	SetDvar( #d"r_fogHeightMapNoiseDt"            , 60 );//Speed of fog Noise movement, larger number appears to be slower. 1 looks to repeat pattern every 1 second.
	SetDvar( #d"r_fogHeightMapNoiseScrollDir"     , "-1 0 1" );//Noise scrolling vector direction in world space
	SetDvar( #d"r_fogHeightMapNoiseFlowmapUVScale", 0 );//broken - leave at 0
	SetDvar( #d"r_fogHeightMapNoiseUVScale", 200 );//Size of fog chunks.  Bigger number is bigger chunks and gaps;
	SetDvar( #d"r_fogHeightMapNoiseBias"   , -0.1 );//Max Density
	
/#
	if ( GetDvar( #d"clientSideEffects" ) != "1" )
	{
	}
#/

}
