	//---------------------VOLUMETRIC Height Fog--------------------------//
	SetDvar( #d"r_volumetricdepth"                   , "4000" );
	SetDvar( #d"r_fogHeightMapNoiseDt", 10 ); //Speed of fog Noise movement, larger number appears to be slower. 1 looks to repeat pattern every 1 second.
	SetDvar( #d"r_fogHeightMapNoiseScrollDir"     , "1 0 0" );//Noise scrolling vector direction in world space
	SetDvar( #d"r_fogHeightMapNoiseFlowmapUVScale", 0 );//broken - leave at 0
	SetDvar( #d"r_fogHeightMapNoiseUVScale", 600 );//Size of fog chunks.  Bigger number is bigger chunks and gaps;
	SetDvar( #d"r_fogHeightMapFade"        , 1 );//Max Density
	SetDvar( #d"r_fogHeightMapNoiseBias"   , -0.1 );//Max Density
	
