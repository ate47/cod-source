/* COLORS */
/* COLORS */

html.is4k {
    font-size: 32px;
}

body {
    background-color: #3e3e3e;
    width: 120rem;
    height: 67.5rem;
    font-size: 1rem;
}

body.is-kbm #acceptances-wrapper::-webkit-scrollbar-thumb {
    background-clip: padding-box;
    background-color: rgba(231, 231, 231, 0.3);
    height: 7.8125rem;
}

body.is-kbm #acceptances-wrapper::-webkit-scrollbar-thumb:vertical:hover {
    background-color: #79c370;
}

body.is-kbm #acceptances-wrapper:hover::-webkit-scrollbar-thumb {
    background-color: #e7e7e7;
}

body.hide-body {
    display: none;
}

body #acceptances {
    background: url('../assets/eula-bg.jpg');
    background-size: contain;
    background-repeat: no-repeat;
    height: 100%;
    margin: 0 auto;
    padding: 2.5rem 4.875rem 0;
    color: #e7e7e7;
    position: relative;
    overflow: hidden;
    font-size: 1.25em;
    color: #e7e7e764;
}

body #acceptances .header {
    display: flex;
    justify-content: space-between;
}

body #acceptances .header .logo-container svg {
    opacity: 0.6;
    width: 12.75rem;
    height: 3.1875rem;
}

body #acceptances .header.is-reaccess {
    justify-content: flex-start;
    align-items: center;
    direction: ltr;
}

body #acceptances .header.is-reaccess .controller-hints .control .icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0px;
}

body .back-button {
    width: 3rem;
    height: 3.375rem;
    display: none;
    align-items: center;
    margin-right: 1rem;
    transition: all 0.2s;
    border-color: rgba(231, 231, 231, 0.1);
    border-width: 0.0625rem;
    border-style: solid;
    border-radius: 0.1875rem;
    justify-content: center;
    background: rgba(20, 19, 19, 0.2);
}

body .back-button svg {
    color: #e7e7e7;
    opacity: 0.6;
}

body .back-button:hover {
    color: #9aa39a;
    background: linear-gradient(180deg, rgba(154, 163, 154, 0.2) 0%, rgba(154, 163, 154, 0.04) 100%), rgba(20, 19, 19, 0.2);
}

body .back-button:hover svg {
    opacity: 0.8;
}

body .back-button.is-reaccess {
    position: relative;
    display: flex;
    top: 0rem;
    margin-right: 1rem;
}

body .back-button .back-button-svg {
    width: 0.75rem;
    height: 1.40625rem;
    fill: #e7e7e7;
}

body .back-button .back-button-svg:hover {
    fill: #e7e7e7;
}

body .back-button .controller-hints .icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.25rem;
}

body .back-button .controller-hints .icon svg {
    fill: #e7e7e7 !important;
}

body .divider hr {
    border: 1px solid #3b3b3a;
    opacity: 0.6;
}

body .divider-top hr {
    opacity: 0.4;
}

body .artifact-step-wrapper {
    display: flex;
}

body .artifact-step {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.9375rem;
    background: linear-gradient(180deg, rgba(20, 19, 19, 0.8) 0%, rgba(59, 59, 58, 0.8) 100%);
    border: 0.0625rem solid rgba(231, 231, 231, 0.24);
    position: relative;
    margin-right: 0.625rem;
}

body .artifact-step.active-step {
    background: #9aa39a;
}

body .content-container {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -55%);
    width: 75%;
    top: 43.5%;
    height: 32.125rem;
}

body .content-container .scroll-overlay {
    position: absolute;
    right: 0;
    width: 0.75rem;
    height: 32.125rem;
    transition: width linear 195ms;
    background-color: #3b3b3a;
    overflow-y: hidden;
}

body .content-container .scroll-overlay::after {
    content: '';
    position: absolute;
    right: 0;
    background: transparent;
    pointer-events: none;
    height: 5.25rem;
    top: 0;
    transition: width linear 195ms;
    width: 100%;
}

body .content-container .scroll-overlay:hover {
    width: 0.75rem;
}

body .controls-container {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translate(-50%, 0);
    width: 70%;
}

body .footer {
    position: absolute;
    width: 100%;
    bottom: 8%;
}

body .controller-hints.is-pc {
    display: none;
}

body .controller-hints.scroll {
    position: absolute;
    left: 97.99%;
    top: 0;
}

body .controller-hints .control {
    display: block;
}

body .controller-hints .control .icon {
    width: 1.5625rem;
    height: 1.5625rem;
    margin-right: 0.5rem;
}

body .controller-hints .control .icon[data-icon-string='rightStickRight'] {
    width: 2.8125rem;
    height: 3.125rem;
}

body .controller-hints .control .copy {
    color: #d2d4cd;
    text-transform: uppercase;
}

body .controller-hints .control svg {
    width: 100%;
    height: 100%;
}

body .copy-container {
    color: #e7e7e7;
}

body .copy-container .artifact-disclaimer {
    font-size: 1.25em;
    color: #e7e7e764;
}

body .copy-container .copyright {
    font-size: 1.125em;
}

body header {
    display: flex;
}

body .step-container {
    display: flex;
}

body .active-artifact-title {
    text-transform: uppercase;
    align-items: center;
    font-size: 1.25em;
    color: #e7e7e764;
    font-size: 2.5em;
    color: #9aa39a;
}

body #controls {
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
}

body #controls.is-reaccess {
    display: none;
}

body #controls .controller-hints {
    top: 50%;
    transform: translate(0, -50%);
    left: 5%;
    position: absolute;
}

body #controls .controller-hints .control .icon {
    width: 1.5625rem;
    height: 1.5625rem;
    margin-right: 0.5rem;
}

body #controls .controller-hints .control .icon[data-icon-string='rightStickRight'] {
    width: 2.8125rem;
    height: 3.125rem;
}

body #controls .controller-hints .control .copy {
    color: #d2d4cd;
    text-transform: uppercase;
}

body #controls .controller-hints .control svg {
    width: 100%;
    height: 100%;
}

body #controls .lock-icon {
    width: 1.5625rem;
    height: 1.5625rem;
    top: 50%;
    transform: translate(0, -50%);
    left: 5%;
    position: absolute;
}

body #controls button {
    font-size: 1.25em;
    color: #e7e7e764;
    background: linear-gradient(180deg, #2a2b2b 0%, #232324 100%);
    border: 0.0625rem solid rgba(154, 163, 154, 0.15);
    opacity: 0.95;
    color: #9aa39a;
    width: 29.875rem;
    height: 3.5rem;
    position: relative;
    outline: none;
    text-transform: uppercase;
    border-radius: 0.25rem;
    margin-top: 1rem;
}

body #controls button .control {
    display: none;
}

body #controls button .lock-icon {
    visibility: hidden;
}

body #controls button.active {
    font-size: 1.25em;
    color: #e7e7e764;
    font-weight: 700;
    color: #141313;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #79c370;
    border: 0.0625rem solid #368947;
    cursor: pointer;
}

body #controls button.active .control {
    display: flex;
}

body #controls button.active#decline {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #ec4442;
    border: 0.0625rem solid #ec4442;
}

body #controls button.active.disabled {
    border: 0.09375rem solid #368947;
}

body #controls button.disabled {
    font-size: 1.25em;
    color: #e7e7e764;
    background: #666a66;
    color: #9aa39a;
    border: 1px solid #9aa39a;
}

body #controls button.disabled.flash {
    background: #e7e7e7;
}

body #controls button.disabled .lock-icon {
    visibility: visible;
}

body #controls button.disabled.active .lock-icon {
    visibility: visible;
}

body #controls button.disabled.active .icon[data-icon-string='select'] {
    visibility: hidden;
}

body #controls button.accept.active:not(.disabled) {
    font-size: 1.25em;
    color: #e7e7e764;
    font-weight: 700;
    color: #141313;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #79c370;
    border: 0.0625rem solid #368947;
    cursor: pointer;
}

body #controls button p {
    pointer-events: none;
}

body #acceptances-wrapper {
    height: 100%;
    overflow-y: scroll;
    position: relative;
    margin-bottom: 4.375rem;
    line-height: 1.5;
}

body #acceptances-wrapper::-webkit-scrollbar {
    width: 0.625rem;
    background: transparent;
}

body #acceptances-wrapper::-webkit-scrollbar-track {
    background-clip: content-box;
}

body #acceptances-wrapper::-webkit-scrollbar-thumb {
    background-color: #e7e7e7;
    background-color: transparent;
    height: 3.125rem;
    border-radius: 0.125rem;
}

body #acceptances-wrapper .acceptance {
    display: none;
    padding: 0 1.5rem;
}

body #acceptances-wrapper .acceptance.active {
    display: block;
}

body #acceptances-wrapper .acceptance header {
    text-transform: uppercase;
    font-size: 2em;
}

body #acceptances-wrapper .acceptance a {
    color: #e7e7e764;
}

body .scroll-warning {
    visibility: hidden;
    width: 100%;
    height: 2.1875rem;
    text-align: center;
    margin-bottom: 1rem;
}

body .scroll-warning.active {
    visibility: visible;
}

body #eula .acceptance-article li {
    padding: 10px 0;
}

body #eula .acceptance-article ol {
    margin: 10px 0;
}

body .acceptance {
    display: none;
    padding: 0 1.5rem;
}

body .acceptance.active {
    display: block;
}

body .acceptance header {
    text-transform: uppercase;
    font-size: 2em;
}

body .acceptance a {
    color: #e7e7e764;
}

body .controller-hints {
    display: flex;
    align-items: center;
}

body .controller-hints .icon[data-icon-string='select'] svg {
    fill: #292b33;
}

body .controller-hints .icon[data-icon-string='back'] svg {
    fill: #292b33;
}

body .controller-hints svg {
    fill: #9aa39a;
}

body.arabic .controller-hints {
    left: unset;
    right: 5%;
}

body.arabic .controller-hints.scroll {
    right: 97.7%;
}

body.arabic .controller-hints .control {
    display: block;
    padding-left: 10px;
}

body.arabic .controller-hints .control .icon {
    margin-right: 0.25rem;
}

body.arabic .lock-icon {
    left: unset !important;
    right: 5% !important;
}

body.arabic .scroll-overlay {
    right: unset;
    left: 0;
}

body.arabic .scroll-overlay::after {
    right: unset;
    left: 0;
}
