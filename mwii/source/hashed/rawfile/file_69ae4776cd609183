initializeMatchRules()
{
	//  set common values
	setCommonRulesFromMatchRulesData();

	//  set everything else (private match options, default .cfg file values, and what normally is registered in the 'else' below)
	SetDynamicDvar(#d"scr_gwai_zoneLifetime", GetMatchRulesData( "kothData", "zoneLifetime" ) );
	SetDynamicDvar(#d"scr_gwai_zoneCaptureTime", GetMatchRulesData( "kothData", "zoneCaptureTime" ) );
	SetDynamicDvar(#d"scr_gwai_zoneActivationDelay", GetMatchRulesData( "kothData", "zoneActivationDelay" ) );
	SetDynamicDvar(#d"scr_gwai_randomLocationOrder", GetMatchRulesData( "kothData", "randomLocationOrder" ) );
	SetDynamicDvar(#d"scr_gwai_additiveScoring", GetMatchRulesData( "kothData", "additiveScoring" ) );
	SetDynamicDvar(#d"scr_gwai_pauseTime", GetMatchRulesData( "kothData", "pauseTime" ) );
	SetDynamicDvar(#d"scr_gwai_spawndelay", GetMatchRulesData( "tdefData", "spawnDelay" ) );

	registerHalfTimeDvar( "gwai", 0 );
