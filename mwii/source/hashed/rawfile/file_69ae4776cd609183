	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByKey( "militarybase"             , "script_noteworthy" );

	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByKey( "location_volume"    , "targetname" );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByKey( "locale_area_trigger", "targetname" );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByKey( "bank_entry_detector", "targetname" );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByKey( "shadow_blocker"     , "targetname" );
	
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByModel( "door_prison_cell_metal_mp"  , true );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByModel( "veh8_mil_air_acharlie130"   , true );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByModel( "door_wooden_panel_mp_01"    , true );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByModel( "me_electrical_box_street_01", true );
	
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByCodeClassname( "light" );
	scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByCodeClassname( "trigger_use_touch" );
	
	if ( IsDefined( level.localeID ) && level.localeID == "locale_6" )
		scripts\cp_mp\utility\game_utility::removeMatchingEnts_ByKey( "locale_8", "script_noteworthy" );
	
	unneededTagOrigins       = [];
	unneededTagOrigins[ 0 ]  = ( -22592, 27367, 1000 ); //Ascender control tower
	unneededTagOrigins[ 1 ] = ( -22592, 27303, -448 ); //Ascender control tower
	unneededTagOrigins[ 2 ] = ( 7837, -9674, 1154 ); //Ascender hospital
	unneededTagOrigins[ 3 ] = ( 7637, -9674, 1154 ); //Ascender hospital
	unneededTagOrigins[ 4 ] = ( 7901, -9674, -270 ); //Ascender hospital
	unneededTagOrigins[ 5 ] = ( 7701, -9674, -270 ); //Ascender hospital
	unneededTagOrigins[ 6 ] = ( 10366, -11606, 66 ); //Ascender hospital
	unneededTagOrigins[ 7 ] = ( 10366, -11813, 66 ); //Ascender hospital
	unneededTagOrigins[ 6 ] = ( 10366, -11670, -270 ); //Ascender hospital
	unneededTagOrigins[ 7 ] = ( 10366, -11877, -270 ); //Ascender hospital
	unneededTagOrigins[ 8 ] = ( 7498, -11716, 66 ); //Ascender hospital
	unneededTagOrigins[ 9 ] = ( 7498, -11652, -270 ); //Ascender hospital;
	unneededTagOrigins[ 10 ] = ( -1200, -18954, -242 ); //Ascender market row
	unneededTagOrigins[ 11 ] = ( -1215, -19016, 774 ); //Ascender market row;
	
	ents = GetEntArray();
	
	foreach ( ent in ents )
	{
		if ( IsDefined( ent.model ) && ent.model == "tag_origin" )
		{
			isBadLoc = false;
			foreach ( badTagOrigin in unneededTagOrigins )
			{
				if ( isBadLoc )
					break;
				
				if ( DistanceSquared( ent.origin, badTagOrigin ) < 12 * 12 )
					isBadLoc = true;
			}
			
			if ( isBadLoc )
				ent Delete();
		}
	}
}

