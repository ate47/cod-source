#define CRATE_LOCATION_TESTING                   false
#define CRATE_DEBUG_LOCATION_DRAW_TIME           1
#define CONST_KILLSTREAK_CRATE_POINT_INTERVAL    100
#define CONST_KILLSTREAKS_DROPPED_PER_INTERVAL   2
#define CONST_TIME_BETWEEN_STREAKS               5

//These points can be used for more than just drop bags. These are locations in the world that are open to the sky and can have a crate drop onto.
registerValidDropLocations()
{
	scripts\cp_mp\killstreaks\airdrop::initPlunderCrateData();
	
	level.validDropLocationStruct          = SpawnStruct();
	level.validDropLocationStruct.clusters = getStructArray( "dropBagCluterNode", "script_noteworthy" );
	potentialDropLocations                 = getStructArray( "dropBagLocation", "script_noteworthy" );
	
	foreach ( location in potentialDropLocations )
	{
		location.inUse = false;
		
		foreach ( cluster in level.validDropLocationStruct.clusters )
		{
			if ( location.target == cluster.targetname )
			{
				if ( !IsDefined( cluster.dropLocations ) )
					cluster.dropLocations = [];
				
				cluster.dropLocations[ cluster.dropLocations.size ] = location;
				continue;
			}
		}
	}
	
	level.nextKillStreakGoal = CONST_KILLSTREAK_CRATE_POINT_INTERVAL;
	
	if ( CRATE_LOCATION_TESTING )
		thread debug_TestCrateDropLocationPicker();
}

debug_TestCrateDropLocationPicker()
{
	while ( true )
	{
		chooseCrateLocation();
		
		wait CRATE_DEBUG_LOCATION_DRAW_TIME;
	}
}

checkKillStreakCrateDrop( team )
{
	if ( game[ "teamScores" ][ team ]     >= level.nextKillStreakGoal )
	{
		level.nextKillStreakGoal += CONST_KILLSTREAK_CRATE_POINT_INTERVAL;
		dropKillstreakCrates( CONST_KILLSTREAKS_DROPPED_PER_INTERVAL );
	}
}

dropKillstreakCrates( numToDrop )
{
	owningPlayer = undefined;
	
	foreach ( player in level.players )
	{
		if ( IsDefined( player ) )
		{
			owningPlayer = player;
			break;
		}
	}
	
	for ( i = 0;i < numToDrop; i++ )
	{
		location = chooseCrateLocation();
		thread runKillstreakReward( location, owningPlayer, getKillStreak( 1 ) );
		wait CONST_TIME_BETWEEN_STREAKS;
	}
}

chooseCrateLocation()
{
	randFrac         = randomFloatRange( 0, 1.0 );
	randPointOnPathA = VectorLerp( level.c130pathStruct_a.startPt, level.c130pathStruct_a.endPt, randFrac );
	randPointOnPathB = VectorLerp( level.c130pathStruct_b.endPt, level.c130pathStruct_b.startPt, randFrac );

	choosenCrateOrigin = VectorLerp( randPointOnPathA, randPointOnPathB, 0.5 );
	
	trace               = ray_trace( choosenCrateOrigin, choosenCrateOrigin - ( 0, 0, 100000 ) );
	choosenCrateOrigin  = trace[ "position" ];
	actualCrateLocation = findClosestDropLocation( choosenCrateOrigin );
	
	if ( CRATE_LOCATION_TESTING )
	{
		thread drawSphere( randPointOnPathA, 1000, CRATE_DEBUG_LOCATION_DRAW_TIME * 100, ( 0, 0, 1 ) );
		thread drawSphere( randPointOnPathB, 1000, CRATE_DEBUG_LOCATION_DRAW_TIME * 100, ( 0, 0, 1 ) );
		thread drawSphere( choosenCrateOrigin, 1000, CRATE_DEBUG_LOCATION_DRAW_TIME * 100, ( 1, 0, 0 ) );
		thread drawSphere( actualCrateLocation.origin, 1000, CRATE_DEBUG_LOCATION_DRAW_TIME * 100, ( 0, 1, 0 ) );
		thread drawLine( choosenCrateOrigin, actualCrateLocation.origin, 3, ( 0, 1, 0 ) );
	}
	
	return actualCrateLocation;
}

findClosestDropLocation( origin )
{
	startLocation        = SpawnStruct();
	startLocation.origin = origin;
	clustersByDistance   = startLocation array_sort_with_func( level.validDropLocationStruct.clusters, ::sortLocationsByDistance );
	
	foreach ( cluster in clustersByDistance )
	{
		randomPotentialLocations = array_randomize( cluster.dropLocations );
		
		if ( CRATE_LOCATION_TESTING )
		{
			return randomPotentialLocations[ 0 ];
		}
		else
		{
			foreach ( location in randomPotentialLocations )
			{
				if ( !location.inUse )
				{
					location.inUse = true;
					return location;
				}
			}
		}
	}
	
	//If we get here, there are no good locations to drop the crate
	return undefined;
}

runKillstreakReward( location, creditPlayer, streakName )
{
	level endon( "game_ended" );
	
	crate = undefined;
	
	object        = scripts\mp\gameobjects::createOBJIDObject( location.origin, "neutral", ( 0, 0, CONST_OBJICON_Z_OFFSET ), undefined, "any" );
	object.origin = location.origin;
	object.angles = location.angles;
	
	thread doCrateDropSmoke( undefined, location, CONST_CRATE_ARRIVAL_SMOKE_TIME );
	
	object.iconName          = "_incoming";
	object.lockUpdatingIcons = false;
	object scripts\mp\gameobjects::setObjectiveStatusIcons( streakName );
	object.lockUpdatingIcons = true;
	
	wait 4;

	crate                          = scripts\cp_mp\killstreaks\airdrop::dropArmCrateFromScriptedHeli( creditPlayer.team, streakName, location.origin, ( 0, RandomInt( 360 ), 0 ), undefined );
	crate.skipMiniMapIcon          = true;
	crate.neverTimeOut             = false;
	crate.waitForObjectiveActivate = true;
	crate.killMiniMapIcon          = false;
	crate.disallowHeadIconID       = true;
	crate.isArmCrate               = true;
	
	crate waittill( "crate_dropped" );
	
	object.useObj = crate;
	object.origin = crate.origin;
	
	currentWait = 0;
	interval    = 0.1;
	
	wait 1;
	
	crate notify( "objective_activate" );
	
	scripts\mp\objidpoolmanager::Update_Objective_OnEntity( object.objIDNum, crate );
	scripts\mp\objIDPoolManager::Update_Objective_SetZOffset( object.objIDNum, CONST_OBJICON_Z_OFFSET );
	
	object.iconName          = "";
	object.lockUpdatingIcons = false;
	object scripts\mp\gameobjects::setObjectiveStatusIcons( streakName );
	object.lockUpdatingIcons = true;
	
	Objective_SetLabel( object.objIDNum, "" );
	
	crate waittill( "death" );
	
	object scripts\mp\gameobjects::setVisibleTeam( "none" );
	object scripts\mp\gameobjects::releaseID();
	object.visibleTeam	= "none";
}

