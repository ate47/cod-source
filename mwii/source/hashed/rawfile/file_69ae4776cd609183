		nodeArray	= GetNodesInRadiusSorted( origin, 512, 0, 512, "Path", 1 );
		
		//thread scripts\cp_mp\utility\debug_utility::drawLine( origin, origin + ( 0, 0, 500 ), 60.0, ( 1, 1, 1 ) );
		if ( isdefined( nodeArray[ 0 ] ) )
		{
			//thread scripts\cp_mp\utility\debug_utility::drawLine( origin, nodeArray[ 0 ].origin, 60.0, ( 1, 0, 0 ) );
			spawnOrigin = nodeArray[ 0 ].origin;
			
			groupName = generateUniqueReinforcementGroupName( spawnOrigin );
			aitype = ai_determineAIType();
			
			agent = ai_mp_requestSpawnAgent( aitype, spawnOrigin, ( 0, 0, 0 ), "medium", "everybody", "captureAgents", groupName, undefined, undefined, undefined, true, true );
			if ( isdefined( agent ) )
			{
				scripts\mp\gametypes\common::commonAI_setupAgent( agent, CONST_DMZ_AGENT_TEAM );
				agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 1024, 512 );
			}
		}
	}
	
	text = 0;
}

spawnAIOnObjectiveForTeam( objectiveKey, team, numAgents, numJuggs )
{
	if ( !isTrue( level.spawnAgentsOnCapture ) )
		return;	
	
	obj       = level.objectives[ objectiveKey ];
	groupName = generateUniqueReinforcementGroupName( obj.trigger.origin );
	cqbStruct = cqb_gatherNodes_aroundOrigin( obj.trigger.origin, 1024, true );
	cqbNodes  = array_combine( cqbStruct.cqbCoverNodes, cqbStruct.cqbCoverNodes_dontMove, cqbStruct.cqbCoverNodes_unlabeled );
	
	if ( !isdefined( numAgents ) )
		numAgents = GetDvarInt(#d"scr_gwai_reinforce_agents_per_objective_count", 5 );
	
	//objectiveOrigin = level.objectives[ objectiveKey ].trigger.origin;
	//agents          = scripts\mp\ai_heli_reinforce::heli_requestReinforcements( numAgents, objectiveOrigin, "medium", "everybody", "heli", objectiveKey, team );
	
	if ( numAgents > 0 )
	{
		for ( i = 0; i < numAgents; i++ )
		{
			aitype = ai_determineAIType();
			
			agent = ai_mp_requestSpawnAgent( aitype, obj.trigger.origin, ( 0, 0, 0 ), "medium", "everybody", "captureAgents", groupName, team, undefined, undefined, true, true );
			if ( isdefined( agent ) )
			{
				scripts\mp\gametypes\common::commonAI_setupAgent( agent, CONST_DMZ_AGENT_TEAM );
				if ( cqbNodes.size > 0 )
				{
					potentialNodes = cqb_pickNodes( agent.origin, cqbNodes, cqbNodes.size, 256, false );
					potentialNodes = array_randomize( potentialNodes );
					
					if ( potentialNodes.size > 0 )
					{
						agent.bAlwaysCoverExposed = true;
						cqb_useNode( agent, potentialNodes[ 0 ] );
					}
					else
					{
						agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 256, 256 );
					}
				}
				else
				{
					agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 256, 256 );
				}
				
				agent SetGoalVolumeAuto( obj.aiVolume );
				//agent scripts\mp\ai_mp_controller::overrideAgentSettings( "body_spetsnaz_cqc", "head_spetsnaz_cqc" );
				
				agent.objectiveKey = objectiveKey;
				level.objectiveReinforcements[ objectiveKey ][ team ].agents[ level.objectiveReinforcements[ objectiveKey ][ team ].agents.size ] = agent;
			}
		}
	}
	
	if ( !isdefined( numJuggs ) )
		numJuggs = GetDvarInt(#d"scr_gwai_reinforce_juggs_per_objective_count", 0 );
	
	if ( numJuggs > 0 )
	{
		for ( i = 0; i < numJuggs; i++ )
		{
			agent = ai_mp_requestSpawnAgent( "actor_enemy_mp_jugg_aq", obj.trigger.origin, ( 0, 0, 0 ), "absolute", "everybody", "jugg", groupName, undefined, undefined, undefined, true, true );
			if ( isdefined( agent ) )
			{
				scripts\mp\gametypes\common::commonAI_setupAgent( agent, CONST_DMZ_AGENT_TEAM );
				scripts\cp_mp\agents\agent_utils::overrideElite( agent );
				
				if ( cqbNodes.size > 0 )
				{
					potentialNodes = cqb_pickNodes( agent.origin, cqbNodes, cqbNodes.size, 256, false );
					potentialNodes = array_randomize( potentialNodes );
					
					if ( potentialNodes.size > 0 )
					{
						agent.bAlwaysCoverExposed = true;
						cqb_useNode( agent, potentialNodes[ 0 ] );
					}
					else
					{
						agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 256, 256 );
					}
				}
				else
				{
					agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 256, 256 );
				}
				
				agent SetGoalVolumeAuto( obj.aiVolume );
			}
		}
	}
}

selectHeliPath( desired_origin, overrideClosestSpawn )
{
	org_struct        = SpawnStruct();
	org_struct.origin = desired_origin;
	
	//use post landing dest to find closest unload loc
	unload_locs = SortByDistance( level.heliReinforceStruct.unload_locs, org_struct.origin );
	
	//nothing found, try the rest of the array in order
	pathNode = scripts\mp\ai_heli_reinforce::heli_findAndReservePathNodes( unload_locs, desired_origin );
	
	if ( isdefined( pathNode ) )
		return pathNode;
	
	return undefined;
}

fixupAgentsArray( agent, killer )
{
	if ( !isdefined( agent.objectiveKey ) || !isGameplayTeam( agent.team ) )
		return;
	
	level.objectiveReinforcements[ agent.objectiveKey ][ agent.team ].agents = array_remove( level.objectiveReinforcements[ agent.objectiveKey ][ agent.team ].agents, agent );
}

manageReinforcementBackfill()
{
	scripts\mp\ai_mp_controller::addAgentDeathCallback( ::fixupAgentsArray, level );
	
	desiredCount        = GetDvarInt(#d"scr_gwai_reinforce_agents_per_objective_count", 5 );
	backfillThreshold   = GetDvarInt(#d"scr_gwai_backfil_agents_per_objective_count", 2 );
	minBackfillInterval = GetDvarInt(#d"scr_gwai_backfil_cooldown", 30 ) * 1000;
	
	level.objectiveReinforcements = [];
	foreach ( key, obj in level.objectives )
	{
		level.objectiveReinforcements[ key ] = [];
		foreach ( team in level.teamNameList )
		{
			data                                         = SpawnStruct();
			data.agents                                  = [];
			data.lastBackfillTime                        = 0;
			level.objectiveReinforcements[ key ][ team ] = data;
		}
	}
	
	while ( true )
	{
		foreach ( key, obj in level.objectives )
		{
			wait 1.0;
			
			team = obj.ownerTeam;
			
			if ( team == "neutral" )
				continue;
			
			currentTime = GetTime();
			if ( currentTime < level.objectiveReinforcements[ key ][ team ].lastBackfillTime + minBackfillInterval )
				continue;
			
			aliveAgents = [];
			foreach ( agent in level.objectiveReinforcements[ key ][ team ].agents )
			{
				if ( agent.health > 0 )
					aliveAgents[ aliveAgents.size ] = agent;
			}
			level.objectiveReinforcements[ key ][ team ].agents = aliveAgents;
			
			currentCount = level.objectiveReinforcements[ key ][ team ].agents.size;
			if ( currentCount <= backfillThreshold )
			{
				level thread spawnAIOnObjectiveForTeam( key, team, desiredCount - currentCount, 0 );
				level.objectiveReinforcements[ key ][ team ].lastBackfillTime = currentTime;
			}
		}		
	}
}

snapshotInventory()
{
	items = [];
	
	inventoryWeapons = scripts\mp\gametypes\br_default_inventory::getInventoryWeapons( self );
	// Weapons
	foreach ( weapon in inventoryWeapons )
	{
		variantID = weapon.variantID;
		if ( !IsDefined( weapon.variantID ) )
		{
			variantID = 0;
		}
		
		rootName = scripts\cp_mp\weapon::getWeaponRootName( weapon );
		lootID   = scripts\cp_mp\weapon::getWeaponLootIDFromRootAndVariant( rootName, variantID );
		
		if ( IsDefined( lootID ) && lootID > 0 )
		{
			item             = SpawnStruct();
			item.lootID      = lootID;
			item.ref         = rootName;
			item.attachments = weapon.attachments;
			item.camo        = weapon.camo;
			item.reticle     = weapon.reticle;
			item.variantID   = variantID;
			item.quantity    = 1;
			
			if ( !IsDefined( items[ "loadoutPrimary" ] ) )
				items[ "loadoutPrimary" ] = item;
			else if ( !IsDefined( items[ "loadoutSecondary" ] ) )
				items[ "loadoutSecondary" ] = item;
		}
	}
	
	self.pers[ "br_ammo" ] = self.br_ammo;
	
	// Equipment
	ref           = self scripts\mp\equipment::getCurrentEquipment( "primary" );
	equipmentAmmo = self scripts\mp\equipment::getEquipmentSlotAmmo( "primary" );
	lootID        = scripts\cp_mp\utility\loot::getLootIDFromRef( ref );
	if ( IsDefined( lootID ) && equipmentAmmo > 0 )
	{
		item          = SpawnStruct();
		item.lootID   = lootID;
		item.ref      = ref;
		item.quantity = 1;
		
		items[ "loadoutEquipmentPrimary"     ] = item;
	}
	
	ref           = self scripts\mp\equipment::getCurrentEquipment( "secondary" );
	equipmentAmmo = self scripts\mp\equipment::getEquipmentSlotAmmo( "secondary" );
	lootID        = scripts\cp_mp\utility\loot::getLootIDFromRef( ref );
	if ( IsDefined( lootID ) && equipmentAmmo > 0 )
	{
		item          = SpawnStruct();
		item.lootID   = lootID;
		item.ref      = ref;
		item.quantity = 1;
		
		items[ "loadoutEquipmentSecondary"     ] = item;
	}
	
	// Super
	ref           = self scripts\mp\equipment::getCurrentEquipment    ( "super" );
	ref           = scripts\cp_mp\utility\loot::fixupBRFieldUpgradeRef( ref );
	equipmentAmmo = self scripts\mp\gametypes\br::getSuperWeaponDisabledAmmoBR();
	lootID        = scripts\cp_mp\utility\loot::getLootIDFromRef( ref );
	if ( IsDefined( lootID ) && equipmentAmmo > 0 )
	{
		item          = SpawnStruct();
		item.lootID   = lootID;
		item.ref      = ref;
		item.quantity = 1;
		
		items[ "loadoutFieldUpgrade1" ] = item;
	}
	
	ref = self scripts\mp\killstreaks\killstreaks::getKillstreakInSlot( 1 );
	if ( IsDefined( ref ) )
	{
		lootID = scripts\cp_mp\utility\loot::getLootIDFromRef( ref.streakname );
		if ( IsDefined( lootID ) )
		{
			item          = SpawnStruct();
			item.lootID   = lootID;
			item.ref      = ref;
			item.quantity = 1;
			
			items[ "loadoutKillstreak1" ] = item;
		}
	}
	
	// Consumables
	// TODO: Cash
	// TODO: Armor
	// TODO: Ammo Types?
	if ( self scripts\mp\gametypes\br_public::hasPlatePouch() )
	{
		lootID = scripts\cp_mp\utility\loot::getLootIDFromRef( "armor_satchel" );
		if ( IsDefined( lootID ) )
		{
			item          = SpawnStruct();
			item.lootID   = lootID;
			item.quantity = 1;
			
			items[ "armorSatchel" ] = item;
		}
	}
	
	itemName  = self.equipment[ "health" ];
	itemCount = self scripts\mp\equipment::getEquipmentSlotAmmo( "health" );
	if ( isdefined( itemName ) && isdefined( itemCount ) && ( itemCount > 0 ) )
	{
		item          = SpawnStruct();
		item.lootID   = scripts\cp_mp\utility\loot::getLootIDFromRef( "armor_plate" );
		item.quantity = itemCount;
		
		items[ "armorPlates" ] = item;
	}
	
	return items;
}

snapshotPlayerInventories()
{
	if ( isTrue( level.processedEOMInventory ) )
		return;
	
	// Reset dead player's persistent loadouts back to use the base
	foreach ( player in level.players )
	{
		player.pers[ "gamemodeLoadout" ] = level.gamemodeLoadout;
		
		if ( isReallyAlive( player ) )
		{
			inventory = player snapshotInventory();
			
			if ( IsDefined( inventory[ "loadoutPrimary" ] ) )
			{
				player.pers[ "gamemodeLoadout" ][ "loadoutPrimary" ] = inventory[ "loadoutPrimary" ] .ref;
				for ( attachmentIndex = 0; attachmentIndex < MAX_PRIMARY_ATTACHMENTS; attachmentIndex++ )
				{
					attachString = scripts\mp\class::getAttachmentLoadoutString( attachmentIndex, "primary" );
					
					player.pers[ "gamemodeLoadout" ][ attachString ] = inventory[ "loadoutPrimary" ].attachments[ attachmentIndex ];
				}
				player.pers[ "gamemodeLoadout" ][ "loadoutPrimaryCamo"        ] = inventory[ "loadoutPrimary" ] .camo;
				player.pers[ "gamemodeLoadout" ][ "loadoutPrimaryReticle"     ] = inventory[ "loadoutPrimary" ] .reticle;
				player.pers[ "gamemodeLoadout" ][ "loadoutPrimaryVariantID"   ] = inventory[ "loadoutPrimary" ] .variantID;
			}
			
			if ( IsDefined( inventory[ "loadoutSecondary" ] ) )
			{
				player.pers[ "gamemodeLoadout" ][ "loadoutSecondary" ] = inventory[ "loadoutSecondary" ] .ref;
				for ( attachmentIndex = 0; attachmentIndex < MAX_PRIMARY_ATTACHMENTS; attachmentIndex++ )
				{
					attachString = scripts\mp\class::getAttachmentLoadoutString( attachmentIndex, "secondary" );
					
					player.pers[ "gamemodeLoadout" ][ attachString ] = inventory[ "loadoutSecondary" ].attachments[ attachmentIndex ];
				}
				player.pers[ "gamemodeLoadout" ][ "loadoutSecondaryCamo"        ] = inventory[ "loadoutSecondary" ] .camo;
				player.pers[ "gamemodeLoadout" ][ "loadoutSecondaryReticle"     ] = inventory[ "loadoutSecondary" ] .reticle;
				player.pers[ "gamemodeLoadout" ][ "loadoutSecondaryVariantID"   ] = inventory[ "loadoutSecondary" ] .variantID;
			}
			
			if ( IsDefined( inventory[ "loadoutEquipmentPrimary" ] ) )
				player.pers[ "gamemodeLoadout" ][ "loadoutEquipmentPrimary" ] = inventory[ "loadoutEquipmentPrimary" ] .ref;
			
			if ( IsDefined( inventory[ "loadoutEquipmentSecondary" ] ) )
				player.pers[ "gamemodeLoadout" ][ "loadoutEquipmentSecondary" ] = inventory[ "loadoutEquipmentSecondary" ].ref;
			
			if ( IsDefined( inventory[ "loadoutFieldUpgrade1" ] ) )
				player.pers[ "gamemodeLoadout" ][ "loadoutFieldUpgrade1" ] = inventory[ "loadoutFieldUpgrade1" ].ref;
			
			if ( IsDefined( inventory[ "loadoutKillstreak1" ] ) )
				player.pers[ "gamemodeLoadout" ][ "loadoutKillstreak1" ] = inventory[ "loadoutKillstreak1" ].ref;
			
			if ( IsDefined( inventory[ "armorSatchel" ] ) )
				player.pers[ "gamemodeLoadout" ][ "armorSatchel" ] = inventory[ "armorSatchel" ];
			
			if ( IsDefined( inventory[ "armorPlates" ] ) )
				player.pers[ "gamemodeLoadout" ][ "armorPlates" ] = inventory[ "armorPlates" ].quantity;
		}
	}
	
	level.processedEOMInventory = true;
}

onTimeLimit()
{
	if ( level.gameEnded )
		return;
	
	// Sudden Death - If someone is interacting with the objective, wait until it is unoccupied before allowing to end on time.
	foreach ( obj in level.objectives )
	{
		if ( obj.claimTeam != "none" || obj.staleMate )
			return;
	}
	
	if ( GetDvarInt( #d"scr_gwai_hack_kill_all_agents", 1 ) == 1 )
		killAllAgents();
	
	snapshotPlayerInventories();
	
	scripts\mp\gamelogic::default_onTimeLimit();
}

onScoreLimit( winner )
{
	if ( level.gameEnded )
		return;
	
	if ( GetDvarInt( #d"scr_gwai_hack_kill_all_agents", 1 ) == 1 )
		killAllAgents();
	
	snapshotPlayerInventories();
}

canEndOnDeadEvent()
{
	if ( level.gameEnded )
		return;
	
	if ( GetDvarInt(#d"scr_gwai_hack_kill_all_agents", 1 ) == 1 )
		killAllAgents();
	
	snapshotPlayerInventories();
	
	return true;
}

killAllAgents()
{
	active_agents = scripts\mp\agents\agent_utility::getActiveAgentsOfType( "all" );
	foreach ( agent in active_agents )
	{
		scripts\mp\agents\agent_utility::killAgent( agent );
	}
}

