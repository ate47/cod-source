onStartGameType()
{
	level.requiredPlayerCountOveride = true;
	
	foreach ( team in level.teamNameList )
	{
		level.requiredPlayerCount[ team ] = Int( level.maxTeamSize * 0.75 );
	}
	
	if ( !level.multiteambased )
	{
		if ( !isDefined( game[ "switchedsides" ] ) )
			game[ "switchedsides" ] = false;
		
		if ( game[ "switchedsides" ] )
		{
			oldAttackers        = game[ "attackers" ];
			oldDefenders        = game[ "defenders" ];
			game[ "attackers" ] = oldDefenders;
			game[ "defenders" ] = oldAttackers;
		}
	}
	
	setClientNameMode( "auto_change" );

	level.objectives             = [];
	level.uncapturableObjectives = [];
	
	initSpawns();
	
	setIconNames();
	
	level.useDomFlag = 0;
	
	//Used if the killstreaks are the objectives
	level.killStreakQueue = [];
	
	level thread setupWaypointIcons();
	
	setupObjectives();
	
	level thread runObjectives();
	
	level.numHQTanks_Axis   = 0;
	level.numHQTanks_Allies = 0;
	level.maxHQTanks        = 0;
	thread init_GroundWarVehicles();
	
	scripts\mp\utility\dialog::initStatusDialog();
	
	//Attempt to clean up as much ent and BR cruft as possible.
	emergency_cleanUpEnts();
	
	//Remove the base patchable collision volumes
	// NOTE-IW8-Lockwood: Removing this line.
	// It was removing tac cover collisions and brushes we needed for patching.
	// We may be able to Hide the entities instead of deleting them to save on client entities.
	// If we can, then that's something we should do globally, not just for arm.
	//thread removePatchableCollision_delayed();

	scripts\cp_mp\parachute::initParachuteDvars();
	
	if ( GetDvarInt(#d"scr_br_armory_kiosk", 0 ) == 1 )
	{
		scripts\mp\gametypes\br_armory_kiosk::init();
		scripts\mp\gametypes\br_armory_kiosk::setBuyStation( "personalOnly" );
		//level thread initObjectiveUpgradeData();
	}
	
	level thread spawnAI();
	
	level thread scripts\cp_mp\uav_tower::init();
}

