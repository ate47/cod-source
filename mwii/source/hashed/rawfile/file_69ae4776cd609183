setupWaypointIcons()
{
	while ( !IsDefined( level.streakGlobals ) || !IsDefined( level.streakGlobals.streakBundles ) )
		waitframe;
	
	foreach ( kiillstreakName, bundle in level.streakGlobals.streakBundles )
	{
		level.waypointColors[ kiillstreakName + "_incoming" ] = "neutral";
		level.waypointBGType[ kiillstreakName + "_incoming" ] = 1;
		// With these crate objectives overlapping with the game mode objectives it was too much UI clutter. The smoke can communicate incoming without this text.
		level.waypointString[ kiillstreakName + "_incoming" ] = ""; // "MP_INGAME_ONLY/INCOMING_OBJ_CAPS";
		level.waypointShader[ kiillstreakName + "_incoming" ] = ter_op( IsDefined( bundle.hudIcon ), bundle.hudIcon, "" );
		level.waypointPulses[ kiillstreakName + "_incoming" ] = 0;
		
		level.waypointColors[ kiillstreakName ] = "neutral";
		level.waypointBGType[ kiillstreakName ] = 1;
		level.waypointString[ kiillstreakName ] = "MP_INGAME_ONLY/OBJ_CAPTURE_CAPS";
		level.waypointShader[ kiillstreakName ] = ter_op( IsDefined( bundle.hudIcon ), bundle.hudIcon, "" );
	}
}

//Bases, FOBs, etc...
setupObjectives()
{
	//Use this wait when you are debugging and need to race to connect the debugger.
	//wait 5;

	level.startingFOBNames_Neutral = [ "gw_fob_01", "gw_fob_02", "gw_fob_03", "gw_fob_04", "gw_fob_05", "gw_fob_06", "gw_fob_07", "gw_fob_08", "gw_fob_09" ];
	
	level.gW_ObjStruct                      = SpawnStruct();
	level.gW_ObjStruct.startingFOBs_Neutral = [];
	
	if ( !IsDefined( game[ "gwai_possible_objective_keys" ] ) )
		game[ "gwai_possible_objective_keys" ] = [];
	
	objKeyIndex = 0;
	[ level.gW_ObjStruct.startingFOBs_Neutral, objKeyIndex ] = gatherObjectives( level.startingFOBNames_Neutral, objKeyIndex );
	
	if ( !IsDefined( game[ "current_objective_key" ] ) || level.selectNewObjectiveRoundCount > 0 && game[ "roundsPlayed" ] % level.selectNewObjectiveRoundCount == 0 )
	{
		possibleLocations = [];
		foreach ( key, used in game[ "gwai_possible_objective_keys" ] )
		{
			dvarKeys = GetDvar(#d"scr_gwai_possible_objective_keys", "" );
			if ( dvarKeys != "" )
			{
				dvarKeys = StrTok( dvarKeys, " " );
				if ( !array_contains( dvarKeys, key ) )
					continue;
			}
			
			if ( !used )
				possibleLocations[ possibleLocations.size ] = key;
		}
		
		if ( possibleLocations.size == 0 )
		{
			foreach ( key, entry in game[ "gwai_possible_objective_keys" ] )
			{
				game[ "gwai_possible_objective_keys" ][ key ] = false;
			}
			
			foreach ( key, used in game[ "gwai_possible_objective_keys" ] )
			{
				dvarKeys = GetDvar(#d"scr_gwai_possible_objective_keys", "" );
				if ( dvarKeys != "" )
				{
					dvarKeys = StrTok( dvarKeys, " " );
					if ( !array_contains( dvarKeys, key ) )
						continue;
				}
				
				if ( !used )
					possibleLocations[ possibleLocations.size ] = key;
			}
		}
		
		keyToUse                                           = possibleLocations[ RandomInt( possibleLocations.size ) ];
		game[ "current_objective_key" ]                    = keyToUse;
		game[ "gwai_possible_objective_keys" ][ keyToUse ] = true;
	}
}

gatherObjectives( arrayToCheck, currentIndex )
{
	targetArray = [];
	
	if ( !IsDefined( arrayToCheck ) || arrayToCheck.size == 0 )
		return[ targetArray, currentIndex];
	
	objKeyArray = [ "_a", "_b", "_c", "_d", "_e", "_f", "_g", "_h", "_i" ];
	objKeyIndex = currentIndex;
	
	foreach ( fobName in arrayToCheck )
	{
		trigger = scripts\cp_mp\utility\game_utility::getLocaleEnt( fobName );
		if ( isdefined( trigger ) )
		{
			fob                = SpawnStruct();
			fob.name           = fobName;
			fob.trigger        = trigger;
			fob.trigger.objKey = objKeyArray[ objKeyIndex ];
			objKeyIndex++;
			
			targetArray[ targetArray.size ] = fob;
			
			if ( !IsDefined( game[ "gwai_possible_objective_keys" ][ fob.trigger.objKey ] ) )
				game[ "gwai_possible_objective_keys" ][ fob.trigger.objKey ] = false;
		}
	}
	
	return[ targetArray, objKeyIndex ];
}



