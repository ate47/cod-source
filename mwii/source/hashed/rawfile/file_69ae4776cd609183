spawnAI()
{
	if ( !isdefined( level.difficultyType ) )
		level scripts\mp\ai_mp_controller::ai_initializeScriptedAgents();
	
	level thread scripts\mp\gametypes\dmz_ai::init();
	scripts\mp\ai_mp_controller::init();
	aiBudget_registerCategory( "everybody", 100 );
	
	level thread scripts\mp\ai_mp_paratrooper::para_reinforce_init();
	level thread scripts\mp\ai_heli_reinforce::heli_reinforce_init();
	
	
	while ( !isTrue( level.objectiveSetupComplete ) )
		waitframe;
	
	level thread manageReinforcementBackfill();
	
	
	//postLandingOrigins = [];
	//foreach ( key, obj in level.objectives )
	//{
	//	tempStruct                                    = SpawnStruct();
	//	tempStruct.origin                             = obj.trigger.origin;
	//	postLandingOrigins[ postLandingOrigins.size ] = tempStruct;
	//}
	//
	//scripts\mp\ai_heli_reinforce::heli_addPostLandingNodes( postLandingOrigins, true );
	//scripts\mp\ai_heli_reinforce::heli_overrideSelectPathFunc( ::selectHeliPath );
	
	ai_waitTillCanSpawn();
	
	foreach ( key, obj in level.objectives )
	{
		groupName = generateUniqueReinforcementGroupName( obj.trigger.origin );
		
		cqbStruct = cqb_gatherNodes_aroundOrigin( obj.trigger.origin, 1024, true );
		cqbNodes  = array_combine( cqbStruct.cqbCoverNodes, cqbStruct.cqbCoverNodes_dontMove, cqbStruct.cqbCoverNodes_unlabeled );
		
		numAgents = GetDvarInt(#d"scr_gwai_initial_agents_per_objective_count", 15 );
		if ( numAgents > 0 )
		{
			for ( i = 0; i < numAgents; i++ )
			{
				aitype = ai_determineAIType( undefined, undefined, groupName, undefined, 3 );
				
				nodeToUse = undefined;
				if ( cqbNodes.size > 0 )
				{
					potentialNodes = cqb_pickNodes( obj.trigger.origin, cqbNodes, cqbNodes.size, 256, false );
					potentialNodes = array_randomize( potentialNodes );
					if ( potentialNodes.size > 0 )
					{
						nodeToUse = potentialNodes[ 0 ];
					}
				}
				
				spawnOrigin = obj.trigger.origin;
				if ( IsDefined( nodeToUse ) )
					spawnOrigin = nodeToUse.origin;
				
				agent = ai_mp_requestSpawnAgent( aitype, spawnOrigin, ( 0, 0, 0 ), "medium", "everybody", "captureAgents", groupName, undefined, undefined, undefined, true, true );
				if ( isdefined( agent ) )
				{
					scripts\mp\gametypes\common::commonAI_setupAgent( agent, CONST_DMZ_AGENT_TEAM );
					if ( IsDefined( nodeToUse ) )
					{
						cqb_useNode( agent, nodeToUse );
					}
					else
					{
						agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 256, 256 );
					}
					
					if ( IsDefined( obj.aiVolume ) )
						agent SetGoalVolumeAuto( obj.aiVolume );
					//agent scripts\mp\ai_mp_controller::overrideAgentSettings( "body_spetsnaz_cqc", "head_spetsnaz_cqc" );
				}
			}
		}
		
		numJuggs = GetDvarInt(#d"scr_gwai_initial_juggs_per_objective_count", 0 );
		if ( numJuggs > 0 )
		{
			for ( i = 0; i < numJuggs; i++ )
			{
				nodeToUse = undefined;
				if ( cqbNodes.size > 0 )
				{
					potentialNodes = cqb_pickNodes( obj.trigger.origin, cqbNodes, cqbNodes.size, 256, false );
					potentialNodes = array_randomize( potentialNodes );
					if ( potentialNodes.size > 0 )
					{
						nodeToUse = potentialNodes[ 0 ];
					}
				}
				
				spawnOrigin = obj.trigger.origin;
				if ( IsDefined( nodeToUse ) )
					spawnOrigin = nodeToUse.origin;
				
				agent = ai_mp_requestSpawnAgent( "actor_enemy_mp_jugg_aq", spawnOrigin, ( 0, 0, 0 ), "absolute", "everybody", "jugg", groupName, undefined, undefined, undefined, true, true );
				if ( isdefined( agent ) )
				{
					scripts\mp\gametypes\common::commonAI_setupAgent( agent, CONST_DMZ_AGENT_TEAM );
					scripts\cp_mp\agents\agent_utils::overrideElite( agent );
					
					scripts\mp\gametypes\common::commonAI_setupAgent( agent, CONST_DMZ_AGENT_TEAM );
					if ( IsDefined( nodeToUse ) )
					{
						cqb_useNode( agent, nodeToUse );
					}
					else
					{
						agent thread scripts\mp\ai_behavior::behavior_GuardWander( agent, 256, 256 );
					}
					
					if ( IsDefined( obj.aiVolume ) )
						agent SetGoalVolumeAuto( obj.aiVolume );
				}
			}
		}
	}
	
	if ( GetDvarInt( #d"scr_gwai_initial_filler_ai", 1 ) == 1 ) 
		level thread spawnFillerAI();
}

