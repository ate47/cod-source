%force_cs_anim_index_match

dirt_bike_aim_yaw: scrub1d( timerange="-205, 205", timevalue=[aim_yaw], alwayson="true", childindex="1" ) complete
{
	dirt_bike_aim_pitch : blendspace1d( range="-90,90", blend_time="0", coords="-85,0,85", value=[aim_pitch] ) complete
	{
		iw9_veh_dirt_bike_seat_0_scrub_aim_up
		iw9_veh_dirt_bike_seat_0_scrub_aim_neutral
		iw9_veh_dirt_bike_seat_0_scrub_aim_down
	}
}
