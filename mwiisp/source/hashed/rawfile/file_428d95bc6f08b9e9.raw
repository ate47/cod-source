/* COLORS */
/* COLORS */

html.is4k {
  font-size: 32px;
}

html[lang="de"] body .controller-hints .control .copy,
html[lang="ru"] body .controller-hints .control .copy {
  font-size: 1.25rem;
}

body {
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #141313;
  font-family: 'VA-Text', 'Stratum2 BETA', 'HelveticaNeueLT Arabic 55 Roman', 'Tazugane Gothic StdN ARIB', 'Noto Sans', 'Bio Sans Cyr C', 'NimbusSansGlobal';
  width: 120rem;
  height: 67.5rem;
  font-size: 1.5rem;
}

body.modal-open {
  background: rgba(62, 62, 62, 0.9);
}

body #acceptances {
  width: 90%;
  margin: 0 auto;
  padding-top: 13.5rem;
  color: white;
  font-size: 1.5rem;
  display: flex;
  justify-content: space-between;
  position: relative;
}

body .content-right {
  width: 70%;
}

body .controller-hints {
  display: flex;
  position: absolute;
  justify-content: space-between;
}

body .controller-hints.is-pc {
  display: none;
}

body .controller-hints .control {
  display: flex;
  align-items: center;
}

body .controller-hints .control .icon {
  width: 1.5625rem;
  height: 1.5625rem;
  margin-right: 0.5rem;
}

body .controller-hints .control .icon[data-icon-string="rightStickLeft"] {
  width: 2.8125rem;
  height: 3.125rem;
}

body .controller-hints .control .copy {
  color: #D2D4CD;
  text-transform: uppercase;
}

body .controller-hints .control svg {
  width: 100%;
  height: 100%;
}

body .content-left {
  width: 28%;
  height: 37.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

body .content-left .copy-container {
  color: #666A66;
  font-size: 1.25rem;
}

body .content-left .controller-hints {
  width: 28%;
  bottom: 0;
}

body .modal-container {
  position: fixed;
  width: 100%;
  height: 100%;
  z-index: 10;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

body .modal-container.hidden {
  display: none;
}

body .decline-modal {
  position: absolute;
  width: 80%;
  max-width: 100rem;
  height: 43.75rem;
  top: 48%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: #3E3E3E;
  z-index: 9;
  display: block;
}

body .decline-modal .controller-hints {
  bottom: 2.5rem;
  left: 4.375rem;
}

body .decline-modal .modal-header-container {
  background: #d2d4cd;
}

body .decline-modal .modal-header-container p {
  text-align: center;
  color: #292B33;
  text-transform: uppercase;
  font-size: 3.5rem;
  font-weight: 700;
  padding: 2.5625rem 0;
}

body .decline-modal .modal-copy-container {
  width: 32.625rem;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  left: 50%;
}

body .decline-modal .modal-copy-container p {
  padding-bottom: 3.125rem;
  text-align: center;
  color: #d2d4cd;
  font-size: 1.5rem;
}

body .decline-modal .modal-btn-container {
  display: flex;
  justify-content: center;
  width: 32.625rem;
}

body .decline-modal .modal-btn-container button {
  width: 15rem;
  height: 3.5rem;
  border: solid 0.063rem transparent;
  outline: none;
  text-transform: uppercase;
  font-weight: 700;
  font-size: 1.5rem;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), rgba(154, 163, 154, 0.16);
  color: #9aa39a;
  border-radius: 0.25rem;
  border: 1px solid rgba(154, 163, 154, 0.16);
}

body .decline-modal .modal-btn-container button.active {
  font-size: 1.5rem;
  font-weight: 700;
  color: rgba(20, 19, 19, 0.8);
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #79C370;
}

body .artifact-item {
  width: 100%;
  height: 2rem;
  display: flex;
  text-transform: uppercase;
  align-items: center;
  font-family: 'VA-Text', 'Stratum2 BETA', 'HelveticaNeueLT Arabic 55 Roman', 'Tazugane Gothic StdN ARIB', 'Noto Sans', 'Bio Sans Cyr C', 'NimbusSansGlobal';
  font-size: 1.5rem;
}

body .artifact-item .counter {
  margin-right: 1.875rem;
  color: #141313;
  height: 1.5625rem;
  width: 1.5625rem;
  background: #666A66;
  border-radius: 0.9375rem;
  text-align: center;
  font-size: 1.125rem;
}

body .artifact-item .artifact-name {
  color: #666A66;
}

body .artifact-item span {
  display: none;
  color: #03cd7b;
  font-weight: bold;
}

body .artifact-item.active {
  color: #79C370;
}

body .artifact-item.active .artifact-name {
  color: #79C370;
}

body .artifact-item.active .counter {
  background: #79C370;
}

body .artifact-item.read .counter {
  color: transparent;
  position: relative;
}

body .artifact-item.read .counter::after {
  content: '';
  height: 0.75rem;
  width: 0.375rem;
  transform: rotate(45deg) translate(-100%, -50%);
  border-bottom: 0.125rem solid #3E3E3E;
  border-right: 0.125rem solid #3E3E3E;
  display: inline-block;
  position: absolute;
  top: 55%;
  left: 40%;
}

body .step-line {
  height: 3.6875rem;
  width: 1px;
  border-left: 1px solid rgba(154, 163, 154, 0.32);
  margin: 0.75rem;
}

body #controls {
  margin: 0 auto;
  display: flex;
  justify-content: flex-end;
}

body #controls button {
  width: 15rem;
  height: 3.5rem;
  border: solid 0.063rem transparent;
  outline: none;
  text-transform: uppercase;
  font-weight: 700;
  font-size: 1.5rem;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), rgba(154, 163, 154, 0.16);
  color: #9aa39a;
  border-radius: 0.25rem;
  border: 1px solid rgba(154, 163, 154, 0.16);
}

body #controls button.active {
  font-size: 1.5rem;
  font-weight: 700;
  color: rgba(20, 19, 19, 0.8);
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #79C370;
}

body #controls button.active#decline {
  border: 1px solid rgba(20, 19, 19, 0.9);
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%), #EC4444;
}

body #controls button.disabled:hover {
  background-color: #889088;
  color: #191818;
}

body #controls button:first-child {
  margin-right: 2.375rem;
}

body #acceptances-wrapper {
  background: rgba(102, 106, 102, 0.12);
  border: 1px solid rgba(231, 231, 231, 0.12);
  color: rgba(231, 231, 231, 0.64);
  height: 37.5rem;
  overflow-y: scroll;
  margin: 0 auto 1.25rem;
  position: relative;
  font-family: 'VA-Text', 'Stratum2 BETA', 'HelveticaNeueLT Arabic 55 Roman', 'Tazugane Gothic StdN ARIB', 'Noto Sans', 'Bio Sans Cyr C', 'NimbusSansGlobal';
}

body #acceptances-wrapper .scroll-banner {
  display: none;
  width: 100%;
  height: 2.1875rem;
  position: sticky;
  top: 0;
  background: #3B3B3A;
  text-align: center;
}

body #acceptances-wrapper .scroll-banner.active {
  display: block;
}

body #acceptances-wrapper .scroll-banner p {
  font-size: 1rem;
  min-width: 3.125rem;
  position: absolute;
  left: 50%;
  transform: translate(-50%, 0);
  z-index: 1;
  text-transform: uppercase;
  color: #79C370;
}

body #acceptances-wrapper .scroll-banner p b {
  display: block;
  line-height: 1rem;
}

body #acceptances-wrapper .scroll-banner .copy-container {
  font-family: 'VA-Text', 'Stratum2 BETA', 'HelveticaNeueLT Arabic 55 Roman', 'Tazugane Gothic StdN ARIB', 'Noto Sans', 'Bio Sans Cyr C', 'NimbusSansGlobal';
  line-height: 0.9;
  width: 3.5rem;
  margin: 0 auto;
  height: 3.5rem;
  transform: rotate(45deg);
  font-size: 1.25rem;
  background: #3B3B3A;
  border-radius: 0.375rem;
}

body #acceptances-wrapper .scroll-banner .copy-container::after {
  content: '';
  width: 0.9375rem;
  height: 0.9375rem;
  position: absolute;
  bottom: 0.3125rem;
  right: 0.3125rem;
  border-right: 0.25rem solid #79C370;
  border-bottom: 0.25rem solid #79C370;
  border-radius: 0.125rem;
}

body #acceptances-wrapper::-webkit-scrollbar {
  width: 0.75rem;
  background: rgba(102, 106, 102, 0.12);
}

body #acceptances-wrapper.scroll-hover-width::-webkit-scrollbar {
  width: 0.75rem;
}

body #acceptances-wrapper::-webkit-scrollbar-track {
  background-clip: content-box;
}

body #acceptances-wrapper::-webkit-scrollbar-thumb {
  background-clip: padding-box;
  background-color: rgba(154, 163, 154, 0.8);
  height: 7.8125rem;
}

body .acceptance {
  display: none;
  padding: 2.8125rem 3.4375rem;
}

body .acceptance.active {
  display: block;
}

body .acceptance.active.active-banner {
  padding-top: 3.4375rem;
}

body .acceptance header {
  text-transform: uppercase;
  font-size: 2rem;
}

body .acceptance a {
  color: rgba(231, 231, 231, 0.64);
}

body #finished {
  display: none;
  font-family: 'VA-Text', 'Stratum2 BETA', 'HelveticaNeueLT Arabic 55 Roman', 'Tazugane Gothic StdN ARIB', 'Noto Sans', 'Bio Sans Cyr C', 'NimbusSansGlobal';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  left: 0;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  height: 20rem;
  height: 5rem;
  justify-content: center;
  align-content: center;
  background-color: white;
  color: black;
  text-transform: uppercase;
  vertical-align: center;
  font-size: 2rem;
}

body #finished.show {
  display: flex;
}

body.arabic #controls {
  flex-direction: row-reverse;
}

body.arabic #controls button:first-child {
  margin-right: 2.375rem;
}

body.arabic .artifact-item .counter {
  margin-right: 0;
  margin-left: 1.875rem;
}

body.arabic .decline-modal .controller-hints {
  left: unset;
  right: 4.375rem;
}