    "hash_48feeb0a47594f38": "Enemy vehicles! Right bank!",
    "hash_51ce375f2990a240": "Go underwater, Sergeant!",
    "hash_2d1c29d821abe8af": "Soap, find cover!",
    "hash_3e05e7a3899497d6": "The river\xe2\x80\x99s slowing us down, mate!",
    "hash_e8bfc638b56d66": "Use the rocks for cover!",
    "hash_3f1e8c0d1984ff76": "Aim for their heads!",
    "hash_1a2ef602b12bc497": "At the window, Soap! We have to move!",
    "hash_13517b638ed815a8": "Copy! Rally at the safehouse!",
    "hash_7a127eec0b172f92": "Engage.",
    "hash_617804ba3578d476": "Fall back! This way!",
    "hash_68e96b373a8e938b": "Fuck it!",
    "hash_679a730268314263": "Hold your fire-",
    "hash_39a776938bb7f920": "Let them get close.",
    "hash_6689e97108a5829e": "Okay! My men are clear!",
    "hash_5b7575ac3e4e1e77": "Soap! We\xe2\x80\x99re getting overrun! Move!",
    "hash_2436b697e548f12a": "Stand by-!",
    "hash_163467d11e2c9a6d": "Target the helmets! They\xe2\x80\x99re weak!",
    "hash_241dc50036a3ddbf": "Use grenades!",
    "hash_7ba11ce2d4f9bbb2": "Victor-1, break contact! Fall back down the mountain!",
    "hash_70a003e5d82bd300": "Weapons free.",
    "hash_2a96d9dc17898fc2": "Weapons free!",
    "hash_7c31f06a6f932b9e": "We\xe2\x80\x99re falling back, Sergeant!",
    "hash_132d79e1a9167b4e": "Break contact, Sergeant! Fall back!",
    "hash_200fc03e44ca216c": "Soap, get to the window now!",
    "hash_5ba7838ea31d8de1": "They\xe2\x80\x99re using shields!",
    "hash_4110d9eb020a31a4": "This way, Sergeant! At the window!",
    "hash_60b671ed2dec8591": "We\xe2\x80\x99ve got incoming.",
    "hash_6b937ad3138839fb": "Secure the white building! Move in!",
    "hash_4d2b49207a953685": "Commander, we\xe2\x80\x99re clear!",
    "hash_2e2de92ba0cb6d23": "Copy! Moving!",
    "hash_4fc117c99342c8d9": "Then we need to move!",
    "hash_5c9c960f58ab91f5": "They\xe2\x80\x99re armored!",
    "hash_33211df73c21f8f": "We\xe2\x80\x99ve got incoming.",
