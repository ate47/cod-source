    "hash_1d3beca72bb44594": "Keep it up.",
    "hash_453aa44382d07649": "Keep your guard up.",
    "hash_111124787fc14f06": "Kill \xe2\x80\x98em quiet- Work our way to the barge\xe2\x80\xa6 Let\xe2\x80\x99s get this done.",
    "hash_2c89f1f58eab6caf": "Looks like they lost you, Sergeant.",
    "hash_2831419c23fe6e74": "More where they came from.",
    "hash_55f5ebff41cac0fc": "Nasty if you're AQ.",
    "hash_de79f27530bc50f": "Nearly at the barge, let\xe2\x80\x99s get after it.",
    "hash_53e0fad772d17691": "Need a hand?",
    "hash_1e0d80dad4a4bd80": "Not a good mornin\xe2\x80\x99 for AQ.",
    "hash_4fdf7967372531ea": "One more on the first pier. Start with him.",
    "hash_220c2ac33d268f48": "Only survivors here should you and me, mate.",
    "hash_6b1c9afa4eaa39cf": "Patrol boat\xe2\x80\x99s on the hunt, stay alert.",
    "hash_4de1a409b8e6eae7": "Right behind ya\xe2\x80\x99.",
    "hash_68b2bd6f9130de5b": "Right with you, Sergeant.",
    "hash_7bf5e7572d887aa8": "Second patrol boat. Watch for it.",
    "hash_bd9fcfea53f4361": "Seems you\xe2\x80\x99re in the clear again, Gaz.",
    "hash_ec05be4895c5201": "Send \xe2\x80\x98em home and swim out.",
    "hash_396b72127355c653": "So far so good.",
    "hash_506b41b9c625e9b0": "Sounds like AQ\xe2\x80\x99s throwing in grenades, keep your distance.",
    "hash_3e8e46a1bf78c529": "Stay alert, keep pressing forward.",
    "hash_c5bbcc198528ba6": "Stay focused and move up.",
    "hash_3f48d0a3f3a5eb80": "Stay on it.",
    "hash_6ec9c22192e9b59e": "Stickin\xe2\x80\x99 and movin\xe2\x80\x99.",
    "hash_145bf60d60afed59": "Swim under and they\xe2\x80\x99ll lose you.",
    "hash_2a65d7b320857155": "Take care o\xe2\x80\x99 that, Gaz.",
    "hash_a02629bad1f76bf": "Take cover underwater and move.",
    "hash_67954d4f8a46736b": "Take \xe2\x80\x98em and get back in.",
    "hash_4c2664debd4667cb": "Take it if you can.",
    "hash_5ea891349f1c653e": "Take out whoever\xe2\x80\x99s aboard if you can.",
    "hash_13ceb5b5c6281edf": "Takin\xe2\x80\x99 a stab at it.",
    "hash_5018ec0bb406efa8": "The water\xe2\x80\x99s your best bet for cover. Stay under and swim.",
    "hash_7f764a5fdf69266b": "They don\xe2\x80\x99t know what\xe2\x80\x99s hitten\xe2\x80\x99 \xe2\x80\x98em.",
    "hash_23b193a0315340d9": "They've got a patrol boat in the harbor.",
    "hash_75ce360f0efa998c": "They know something\xe2\x80\x99s wrong.",
    "hash_4fc16048b0abf0fc": "They know you\xe2\x80\x99re there.",
    "hash_594a7175d143ed82": "They\xe2\x80\x99re looking for us, keep moving.",
    "hash_7e98f601e4e76d68": "They\xe2\x80\x99re looking for ya.",
    "hash_55bea13e0d031cb5": "They\xe2\x80\x99re trying to flush us out with grenades.",
    "hash_546453389dcde114": "They\xe2\x80\x99re using grenades in the water, watch your arse.",
    "hash_1321f57dd97c8031": "They see you.",
    "hash_684958e459bdd507": "They spotted you.",
    "hash_41b0c433f6bb4daf": "They\xe2\x80\x99ve got grenades. Be careful.",
    "hash_57f372704523f518": "I think they lost sight o\xe2\x80\x99 you.",
    "hash_62d37e060c999714": "Think you\xe2\x80\x99re in the clear there.",
    "hash_2dd4a5740e809d4c": "Tough day at the office for AQ.",
    "hash_1eafad6506713f89": "Turn back, we can\xe2\x80\x99t leave any stragglers.",
    "hash_3b127a378210d3b8": "Watch out, they see you.",
    "hash_1ded6e8f222517f4": "Watch your back, they\xe2\x80\x99re on the hunt.",
    "hash_134a196fcf3621bf": "Watch yourself, Gaz, boat\xe2\x80\x99s looking for you.",
    "hash_74d92bf46c007304": "Well done, mate.",
    "hash_8f5581ca6f01f2": "We\xe2\x80\x99re close. Rally at the barge.",
    "hash_457b3e7f6f16ade9": "We\xe2\x80\x99re in the middle of the city. Don\xe2\x80\x99t make a ruckus.",
    "hash_56b147613baf6ded": "We\xe2\x80\x99re taking a good stab it. Almost to the barge.",
    "hash_209c7f8c3c1cd91e": "Working our way to the barge, burying Al Qatala at sea.",
    "hash_f532311bcc9a214": "You got a few more, don\xe2\x80\x99t leave anyone out.",
    "hash_35b6541fda658494": "You've got guards behind you, circle back and get \xe2\x80\x98em.",
    "hash_5d89c77a541a8450": "You left one alive, go back for him.",
    "hash_100e10fb28e3989c": "Good here, Cap.",
    "hash_48bdbb544512315d": "Is it carrying a missile container?",
    "hash_b2212d1d42f436": "Is it carrying ballistic missiles?",
    "hash_239ffe1086e9db51": "Less than an hour. Where are you now?",
    "hash_4ffdfe4d21513943": "Well, let\xe2\x80\x99s hope it leads us to the one that does.",
    "hash_6be2af3509fdf225": "Canals. Under a bridge, watching an AQ boat.",
    "hash_1c0ca4c2673548e4": "Gaz- You set?",
    "hash_3809704cce8523d1": "I\xe2\x80\x99ll be in touch.",
    "hash_2b86113cc6a8bc64": "Let\xe2\x80\x99s get after it.",
    "hash_48ffbb473252b4cd": "Negative, not this one.",
    "hash_4684f38393b304c5": "What\xe2\x80\x99s your ETA?",
    "hash_790becabe2b3c4fe": "Yeah - AQ guards all over the docks.",
    "hash_1aab86a81e0982cd": "Check. On you, Cap.",
    "hash_1a0b5ed52e082b21": "Copy, John, what do ya got?",
    "hash_7c289073c5f3790f": "That\xe2\x80\x99s your target. Get aboard and find out who they\xe2\x80\x99re working with.",
    "hash_75a48baf9c76f579": "You\xe2\x80\x99ll need to take \xe2\x80\x98em out to get to the barge.",
    "hash_753cf1e5bc8707e7": "You two get to work. Out.",
    "hash_6bde5760b47e994c": "I got AQ loading cargo into a barge.",
    "hash_6e03f275cf170480": "Got sentries on the perimeter.",
    "hash_2c1320da4cafa7f7": "I'll meet you at the barge.",
    "hash_3a8687c1f46bd0": "All right, Laswell, we\xe2\x80\x99re in position.",
    "hash_1ea02d86bd28ef17": "Rog.",
    "hash_63d410b2ce5d80f6": "All right, let's split up. I\xe2\x80\x99ll take the outside, you clean up the docks. Stay quiet.",
