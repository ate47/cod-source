    "hash_3e80f14d241830fb": "Ghost",
    "hash_3cd100ec3dd4e32a": "Graves",
    "hash_55075989d391a0b8": "Laswell",
    "hash_6a2111cb85d93baf": "Shepherd",
    "hash_693bcf8905d3c569": "Got a heli incoming.",
    "hash_3be8d83bf71aa1dc": "Ghost, push up to the top and tell us what you\xe2\x80\x99ve got.",
    "hash_218112588e192ef7": "That\xe2\x80\x99s General Ghorbrani.",
    "hash_18175a2f8c2466e4": "Actual to Ghost, we need eyes on Ghorbrani, get to it, son.",
    "hash_4ace8c2e06809c42": "Now get up there and let\xe2\x80\x99s see what he\xe2\x80\x99s up to in the middle o\xe2\x80\x99 nowhere.",
    "hash_6a2152179f82480f": "Ghost, relay when the target is visual.",
    "hash_38a8a1349f1eda5e": "He\xe2\x80\x99s punctual, I\xe2\x80\x99ll give him that.",
    "hash_58b20ceea3624865": "Right on time.",
    "hash_4d8a44b711b87ea9": "2,1\xe2\x80\x94\xe2\x80\x94 Shot out, missile is loose!",
    "hash_6b8e5ab386570aa6": "All stations, Shadow-1. Missile is ready for immediate delivery, stand by for launch\xe2\x80\xa6",
    "hash_5012ec14ff944cb5": "Brace for impact\xe2\x80\xa6",
    "hash_21699bc83d59d77b": "Check, comin\xe2\x80\x99 in hot\xe2\x80\xa6",
    "hash_1faa2b3d0b0a076f": "Coordinates in\xe2\x80\xa6",
    "hash_546bf7d3d3480b2b": "Link is good, target acquired.",
    "hash_733a55f9935d29b9": "Missile bearing northeast at 0-6-5 degrees at Mach 3\xe2\x80\xa6 Altitude 500 meters.",
    "hash_542fbf395d84ea52": "Target designated\xe2\x80\xa6",
    "hash_59622e6d338a1cc6": "Termination in 3,2,1\xe2\x80\xa6",
    "hash_6e08af20764b6b51": "This will take some manual guidance to hold her\xe2\x80\xa6",
    "hash_6a52a9b13c90bcc9": "Time to target 5 seconds.",
    "hash_71c6dd5196954d4f": "Adjust 5 degrees left.",
    "hash_223645d4eb7121c0": "Adjust 5 degrees right.",
    "hash_2e13e540d841c514": "Adjust course, you\xe2\x80\x99re off target\xe2\x80\xa6",
    "hash_6c9b26b1df4b1627": "Atta boy, Shadow-1, heading is good.",
    "hash_7470914eea57a67f": "Bearing is good, Shadow-1\xe2\x80\xa6",
    "hash_6ddad6c494617f1c": "Check your heading, Shadow-1\xe2\x80\xa6",
    "hash_2974477f080bcb9a": "Hold your heading, Shadow-1\xe2\x80\xa6",
    "hash_3f783e6a01ddfd98": "I want this warhead on a forehead, adjust your bearing, now\xe2\x80\xa6!",
    "hash_79d4f528208dd942": "Line back up on target, Shadow-1\xe2\x80\xa6",
    "hash_538930070762d8ab": "Missile is drifting off course, adjust, right.",
    "hash_7e7468e3662ec20e": "Missile is veering toward obstacles, adjust, left.",
    "hash_1cbd9996445a9a2b": "You're back on target, Shadow-1, good effect\xe2\x80\xa6",
    "hash_a68b0424dc3bd5f": "You\xe2\x80\x99re going off course\xe2\x80\xa6",
    "hash_5ecfbc7eeda96ad9": "You\xe2\x80\x99re right in the pocket, stay with it\xe2\x80\xa6",
    "hash_5642161804c18ad7": "Bloody fucking hell.",
    "hash_6891046ab83ac1d5": "Direct... Target destroyed...",
    "hash_4ec0da48ce639349": "Good effect\xe2\x80\xa6 Target destroyed\xe2\x80\xa6",
    "hash_760662603d8e7c01": "Copy. Approved. Send it.",
    "hash_43b22dc99175052d": "Visual on General Ghorbrani.",
    "hash_5816b0e2711d0f48": "Ghost, you are danger close to the zone, this arrow\xe2\x80\x99s gonna pack a punch\xe2\x80\xa6",
    "hash_5d3cb4f46a57af3": "Roger that, Actual.",
    "hash_5ab2432b86994238": "Copy. All stations- target confirmed.",
    "hash_4aae6ca2e69b9ea5": "Shadow-1- You are cleared hot for launch.",
    "hash_3e4094201484b91c": "Armed escorts around one VIP. Russians are very happy to see him.",
    "hash_66a68c0e6a3045e3": "Armed personnel, armor and hardware\xe2\x80\xa6 All Russian.",
    "hash_5361da9f7f619f71": "I\xe2\x80\x99m eyes on.",
    "hash_5db139a541085f3c": "No joy, stand by.",
    "hash_84a0fa75e62c6ce": "Scanning, hold tight.",
    "hash_7db0c80d6448a77e": "Affirmative- two birds, one stone\xe2\x80\xa6",
    "hash_75847c510cbad164": "It\xe2\x80\x99ll be the last time they do\xe2\x80\xa6",
    "hash_275aa9de05bc2e9b": "Missile is hot, we gotta fish or cut bait, here.",
    "hash_9631f40d666faa9": "Ghost, do you have positive ID on Ghorbrani?",
    "hash_7a009bdc54df5f1d": "Supplying Iran. It\xe2\x80\x99s an arms deal.",
    "hash_6ff165cbfb065323": "Watch that VIP, Ghost, that\xe2\x80\x99s gotta be him.",
    "hash_192d07f734500400": "We need positive ID on Ghorbrani before we kick this off, boys.",
    "hash_4979536ead8a72ed": "What do you see?",
    "hash_59b16c991b912e4f": "Ghost, can you identify the General?",
    "hash_430f608096d3cb61": "Ghost, General Ghorbrani will have close protection, likely AQ guards.",
    "hash_7f2c948768a9250a": "Ghost, get your glass in there and find the General.",
    "hash_1accc5b43bc21ad4": "Ghost, make sure there are no civilians on that X\xe2\x80\xa6",
    "hash_512a691ff68a381b": "Ghost, stay with that protection detail for PID on the target.",
    "hash_5a81cfd8782fefec": "It\xe2\x80\x99ll be the last time they do\xe2\x80\xa6",
    "hash_65c507cb0df28e02": "What the hell are the Russians doin\xe2\x80\x99 with Ghorbrani?",
    "hash_6e473e1110fee2cb": "You copying this, Shadow-1?",
    "hash_17283e68c2ab3f69": "Nearly there.",
    "hash_2bf52ab76b4a71fe": "Gold Eagle Actual, Shadow-1 is weapons hot. We\xe2\x80\x99re burning daylight here...",
    "hash_3d87be66b2d3fbdb": "Watcher-1 to Bravo 0-7, you in position?",
    "hash_29d6084078c22aeb": "Copy, Graves. Stand by.",
