    "hash_1392e19ed5299e3c": "^1Al-Qatala Fighter 1:^7 Fire!",
    "hash_2bd517cfb867ec3a": "^1Al-Qatala Fighter 2:^7 I'll kill her! I'll fucking kill her!",
    "hash_5009abca261eb8cc": "Dipaolo",
    "hash_5ae7bc7ca3ecf315": "Erikson",
    "hash_3cd100ec3dd4e32a": "Graves",
    "hash_677b1aafe2a627fa": "Konni Captain",
    "hash_20deef0fb9693d2e": "Konni PMC 1",
    "hash_20deee0fb9693b7b": "Konni PMC 2",
