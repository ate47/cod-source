    "subtitle_safehouse_finale/dx_vom_rooftop_street_lass_150": "^2Laswell:^7 Copy, 3-1. I'm tasking an unmarked gunship to your position, stand by.",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf1_60": "^2Militia Fighter 1:^7 Yes, sir!",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf3_110": "^2Militia Fighter 3:^7 The cannon is ready to fire, commander.",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf3_130": "^2Militia Fighter 3:^7 Yes, Karim.",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf3_40": "^2Militia Fighter 3:^7 Second group with me.",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf3_50": "^2Militia Fighter 3:^7 Ali, haul the extra ammo.",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf4_100": "^2Militia Fighter 4:^7 By any means necessary!",
    "subtitle_safehouse_finale/dx_vom_rooftop_street_lf4_80": "^2Militia Fighter 4:^7 Wouldn't miss a slaughter on Barkov's dogs for the world!",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_alx_26": "^2Alex:^7 Not bad.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_fsa1_30": "^2Militia Fighter 1:^7 Taking these to the Hell-Cannon, Lieutenant.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_fsa1_50": "^2Militia Fighter 1:^7 Yes, Lieutenant!",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_had_05": "^2Hadir:^7 You're in my house now, Alex. I set up shop on the edge of Barkov's base... Keep those fuckers on notice-- Friends close, enemies closer...",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_had_10": "^2Hadir:^7 I told you, we have our ways.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_had_20": "^2Hadir:^7 No grenades, so we improvise.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_had_27": "^2Hadir:^7 You think we fight this war with sticks and stones?",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_had_40": "^2Hadir:^7 Quickly, cousin!",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_intro_had_60": "^2Hadir:^7 The Russians only understand violence... So I show them violence.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_far_120": "^2Farah:^7 Are we ready?",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_far_125": "^2Farah:^7 There are still Russian helicopters on the tarmac. Let's see if we can keep them there...",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_10": "^2Hadir:^7 Barkov has an air force, so we have one too.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_100": "^2Hadir:^7 Good. Launch the second after we breach.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_130": "^2Hadir:^7 Yes, Commander. Let's fly.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_20": "^2Hadir:^7 Alex, come. To the roof.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_30": "^2Hadir:^7 Come, Alex. This way.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_40": "^2Hadir:^7 Follow me, Alex.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_had_80": "^2Hadir:^7 RC planes loaded with C-4.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planeintro_yas_90": "^2Lina:^7 First wave's up. We're hot, sir.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_alx_50": "^2Alex:^7 Alright- Let's crash some planes...",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_alx_80": "^2Alex:^7 I'm in.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_far_60": "^2Farah:^7 Control your plane, Alex.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_had_10": "^2Hadir:^7 Alex, fly into the helicopter for impact.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_had_20": "^2Hadir:^7 Take the remote, Alex.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_had_30": "^2Hadir:^7 Take it, Alex.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_had_40": "^2Hadir:^7 Alex, take the control.",
    "subtitle_safehouse_finale/dx_vom_safehouse_interior_planestart_had_70": "^2Hadir:^7 Use the control, Alex.",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_alx_10": "^2Alex:^7 Where's the last armory?",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_alx_30": "^2Alex:^7 Roger that!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_far_150": "^2Farah:^7 Get to the hangar! Take their armory!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_far_151": "^2Farah:^7 Move cover to cover!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_far_210": "^2Farah:^7 Everyone inside! Clear the hangar!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_far_220": "^2Farah:^7 They cut the power.",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_far_40": "^2Farah:^7 Press the attack, cousins!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_had_152": "^2Hadir:^7 Keep pushing to the hangar!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_had_153": "^2Hadir:^7 To the hangar! Let's go! Let's go!",
    "subtitle_safehouse_finale/dx_vom_tarmac_assault_had_20": "^2Hadir:^7 In that hangar across the tarmac! We take it and the base is ours!",
    "subtitle_safehouse_finale/dx_vom_tarmac_ruradio_ru1_10": "^1Russian Soldier 1:^7 Base, we're almost to you. What is your status?",
    "subtitle_safehouse_finale/dx_vom_tarmac_ruradio_ru1_20": "^1Russian Soldier 1:^7 Base, report!",
    "subtitle_safehouse_finale/dx_vom_tarmac_ruradio_ru1_30": "^1Russian Soldier 1:^7 All teams, Base has been overrun, switch cryptography.",
    "subtitle_safehouse_finale/dx_vom_tarmac_snipers_far_10": "^2Farah:^7 Snipers!",
    "subtitle_safehouse_finale/dx_vom_tarmac_snipers_far_20": "^2Farah:^7 Snipers! Watch out!",
    "subtitle_safehouse_finale/dx_vom_tarmac_snipers_far_30": "^2Farah:^7 Heads down! Snipers!",
    "subtitle_safehouse_finale/dx_vom_tarmac_snipers_had_10": "^2Hadir:^7 Shoot the snipers!",
    "subtitle_safehouse_finale/dx_vom_tarmac_snipers_had_20": "^2Hadir:^7 Snipers! Take them out!",
    "subtitle_safehouse_finale/dx_vom_tarmac_snipers_had_30": "^2Hadir:^7 Bastard snipers!"
}