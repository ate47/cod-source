%lod_distances ( 
	650,	// fingers, facial anims
	800,	// IK, antislide
	1000,	// procedural/dynamic
)

// force anim indexes to match between server and client in MP/CP. Only remove leaf nodes when the xanim asset is not present in the current level. Keep all anim blend/custom nodes even if they are empty.
%force_cs_anim_index_match


inner_root
{
headlook_graft_node : unnormalized additive graft
{
}

gesture_graft_node : graft overlay unnormalized
{
}

ik_fingers_l : clientonly overlay lod_cull(0)
{
	#ik_finger_pose_l
	
}

ik_fingers_r: clientonly overlay lod_cull(0)
{
	#ik_finger_pose_r
}

aim_graft_node : additive unnormalized graft
{
}

gundown_graft_node : graft unnormalized
{
}	

gun_down : unnormalized_auto overlay
{
	
	gun_down_cqb : toggle ( index=[gunadditiveindex], blendcurve="ease_inout_quad", blendtime="0.4", restart="false", clearifnochild="true" )
	{
		sdr_cqb_fast_gun_down
		sdr_cqb_fast_ready
		sdr_cqb_fast_ads
		sdr_cqb_fast_nvg_ads
		
