shoot_additives_rifle : toggle( index=[shootstyle], restart="false" ) additive
{
	shoot_idle : randomloop( blendtime=".2", restart="false", seed=[animtime] ) unnormalized
	{
		sdr_com_exposed_twitch01@2
		sdr_com_exposed_twitch02@2
		sdr_com_exposed_twitch03@2
		sdr_com_exposed_twitch04@2
	}

	shoot_single : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_semi_01@2
	}

	shoot_semi : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for semi-auto to start at 2 shots 
		sdr_com_exposed_semi_02@3
		sdr_com_exposed_semi_03@3
		sdr_com_exposed_semi_04@3
		sdr_com_exposed_semi_05@3
	}

	shoot_full : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		// numshots is reduced by 1 for full-auto to start at 2 shots 
		sdr_com_exposed_burst_02@3
		sdr_com_exposed_burst_03@3
		sdr_com_exposed_burst_04@3
		sdr_com_exposed_burst_05@3
		sdr_com_exposed_burst_06@3
	}
	
	shoot_rack : toggle( index=[numshots], notifyname="shoot_additive_fire", errorifnochild="false" ) unnormalized
	{
		sdr_com_exposed_stand_shotgun_fire01
		sdr_com_exposed_stand_shotgun_fire02
		sdr_com_exposed_stand_shotgun_fire03
	}
}

