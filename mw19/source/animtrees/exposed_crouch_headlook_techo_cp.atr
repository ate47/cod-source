// force anim indexes to match between server and client in MP/CP. Only remove leaf nodes when the xanim asset is not present in the current level. Keep all anim blend/custom nodes even if they are e
%force_cs_anim_index_match

lookatpos_exposed_crouch : toggle ( index=[lookatstate], blendcurve="ease_inout_quad", blendtime="0.4", restart="false", clearifnochild="false" )
{

	lookatpos_exposed_crouch_gundown : blendspace2d( rangex="-135,135", rangey="-90,90", blend_time="60",
		coords="{-135,-56},{-135,0},{-135,56},{0,-90},{0,0},{0,90},{135,-51},{135,0},{135,56},{-135,-90},{-135,90},{135,90},{135,-90}",
		edges="{0,1,4},{0,3,4},{3,4,7},{3,6,7},{1,4,5},{1,2,5},{4,5,8},{4,7,8},{0,3,9},{2,5,10},{5,8,11},{3,6,12}",
		valuex=[lookatyaw], valuey=[lookatpitch] )
	{
		sdr_com_exposed_crouch_gun_down_head_look_techo_01
		sdr_com_exposed_crouch_gun_down_head_look_techo_03
		sdr_com_exposed_crouch_gun_down_head_look_techo_05
		sdr_com_exposed_crouch_gun_down_head_look_techo_16
		sdr_com_exposed_crouch_gun_down_head_look_techo_18
		sdr_com_exposed_crouch_gun_down_head_look_techo_20
		sdr_com_exposed_crouch_gun_down_head_look_techo_31
		sdr_com_exposed_crouch_gun_down_head_look_techo_33
		sdr_com_exposed_crouch_gun_down_head_look_techo_35
		sdr_com_exposed_crouch_gun_down_head_look_techo_01@1
		sdr_com_exposed_crouch_gun_down_head_look_techo_05@1
		sdr_com_exposed_crouch_gun_down_head_look_techo_35@1
		sdr_com_exposed_crouch_gun_down_head_look_techo_31@1
	}
	
	lookatpos_exposed_crouch_gunup : blendspace2d( rangex="-90,90", rangey="-90,90", blend_time="60",
		coords="{-90,-56},{-90,0},{-80,56},{0,-90},{0,0},{0,90},{90,-51},{90,0},{90,56},{-90,-90},{-90,90},{90,90},{90,-90}",
		edges="{0,1,4},{0,3,4},{3,4,7},{3,6,7},{1,4,5},{1,2,5},{4,5,8},{4,7,8},{0,3,9},{2,5,10},{5,8,11},{3,6,12}",
		valuex=[lookatyaw], valuey=[lookatpitch] )
	{
		sdr_com_exposed_crouch_head_only_techo_01
		sdr_com_exposed_crouch_head_only_techo_03
		sdr_com_exposed_crouch_head_only_techo_05
		sdr_com_exposed_crouch_head_only_techo_16
		sdr_com_exposed_crouch_head_only_techo_18
		sdr_com_exposed_crouch_head_only_techo_20
		sdr_com_exposed_crouch_head_only_techo_31
		sdr_com_exposed_crouch_head_only_techo_33
		sdr_com_exposed_crouch_head_only_techo_35
		sdr_com_exposed_crouch_head_only_techo_01@1
		sdr_com_exposed_crouch_head_only_techo_05@1
		sdr_com_exposed_crouch_head_only_techo_35@1
		sdr_com_exposed_crouch_head_only_techo_31@1
	}
	
}

