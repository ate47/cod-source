// force anim indexes to match between server and client in MP/CP. Only remove leaf nodes when the xanim asset is not present in the current level. Keep all anim blend/custom nodes even if they are empty.
%force_cs_anim_index_match

lookatpos_cas_kill_walk : blendspace2d( rangex="-135,135", rangey="-90,90", blend_time="30",
	coords="{-135,-56},{-135,0},{-135,56},{0,-90},{0,0},{0,90},{135,-51},{135,0},{135,56},{-135,-90},{-135,90},{135,90},{135,-90}",
	edges="{0,1,4},{0,3,4},{3,4,7},{3,6,7},{1,4,5},{1,2,5},{4,5,8},{4,7,8},{0,3,9},{2,5,10},{5,8,11},{3,6,12}",
	valuex=[lookatyaw], valuey=[lookatpitch] )
{
	sdr_cas_kill_walk_head_only_01
	sdr_cas_kill_walk_head_only_03
	sdr_cas_kill_walk_head_only_05
	sdr_cas_kill_walk_head_only_16
	sdr_cas_kill_walk_head_only_18
	sdr_cas_kill_walk_head_only_20
	sdr_cas_kill_walk_head_only_31
	sdr_cas_kill_walk_head_only_33
	sdr_cas_kill_walk_head_only_35
	sdr_cas_kill_walk_head_only_01@1
	sdr_cas_kill_walk_head_only_05@1
	sdr_cas_kill_walk_head_only_35@1
	sdr_cas_kill_walk_head_only_31@1
}


