aim: additive unnormalized scrub1d( timerange="0,1", timevalue=[aim_scrub_value], weightValue=[aim_weight_value] )
{
	aim_additive_scale: blend_mode(continuous)
	{
		#aim_anim_slot
	}
}

sc_mantle_on_fwd : scrub1d( timerange="0,1", timevalue=[bsparam_mantle_progress], autoselfclear="false" ) parse_cull(disable)
	{
		#bs_mantle_on_fwd_slot
	}
	
base
	{
		#base_anim_slot
	}
	
torso_overlay: overlay
	{
		#torso_overlay_anim_slot
	}
	
adjust: additive_multiply
	{
		#adjust_anim_slot
	}
	
puck_offset_add: additive_multiply
	{
		#puck_idle_add	
	}
	
melee: overlay nonloopsync
    {
        #melee_anim_slot
    }
	
melee_hips: additive
	{
		#melee_hips_slot
	}		

bs_jup_mp_hellhound_slope_compensator: additive scrub1d( timerange="-10,-0.01", timevalue=[bsparam_slope_height_adjust], weightValue=1.0, childindex="1" ) parse_cull(disable)
	{
		jup_mp_hellhound_slope_compensator
	}
